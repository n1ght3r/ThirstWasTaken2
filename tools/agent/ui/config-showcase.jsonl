{"id": "appleSkinDrawn", "command": "wait", "args": {"ticks": 12}}
{"id": "toOutline", "command": "client.mouse", "args": {"x": 172, "y": 145, "from": "top", "ticks": 7}}
{"id": "outlineIce", "command": "client.click", "expect": {"result.taken": true}}
{"id": "outlineIceDrawn", "command": "wait", "args": {"ticks": 14}}
{"id": "outlineGold", "command": "client.click", "expect": {"result.taken": true}}
{"id": "outlineGoldDrawn", "command": "wait", "args": {"ticks": 14}}
{"id": "outlineAppleSkin", "command": "client.click", "expect": {"result.taken": true}}
