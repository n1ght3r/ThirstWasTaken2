{"id": "dropletsDrawn", "command": "wait", "args": {"ticks": 20}}
{"id": "dropletsOn", "command": "client.click", "expect": {"result.taken": true}}
{"id": "dropletsOnDrawn", "command": "wait", "args": {"ticks": 20}}

