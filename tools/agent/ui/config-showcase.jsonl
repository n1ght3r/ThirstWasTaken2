{"id": "toToggle", "command": "client.mouse", "args": {"x": 122, "y": 130, "from": "top", "ticks": 7}}
{"id": "toggle", "command": "client.click", "expect": {"result.taken": true}}
{"id": "toggleDrawn", "command": "wait", "args": {"ticks": 12}}

