// The config screen: the sidebar switching pages, a page's tabs, the Item Values page's "Open" button, and Done and
// Cancel closing the screen. 26.3 moved the call that button makes onto Blaze3D.openPath, so pressing
// it is the check: an action that failed to link would take the client down with it, and the requests
// after it would go unanswered.
//
//     ./gradlew ":26.3.x:runClient" -Pagent=tools/agent/ui/config-screen.jsonl -Pquickplay=AgentPass
//
// **Pressing that button opens config/thirstwastaken2.json in whatever the desktop uses for .json.**
// Close it afterwards; nothing is written.
//
// The sidebar is anchored to the top-left corner, so its tabs are clicked from the corner: tab i spans
// y = 38 + 24 i to 60 + 24 i, x = 4 to 92 at least. The list is at most 360 wide and, on a GUI 483 px
// or wider, its right edge sits 224 px right of the centre, under a 32 px header. Under the page
// heading (30) sits the strip of tabs (18); Item Values has two, Item List and Matching, each half
// the list. The Open button is the last 80 px of the row after Matching's two settings (22 each, 2
// between rows), so its middle is 40 + 32 + 20 + 48 + 11 = 151 down. The footer's
// Cancel and Done are right-aligned, so their offset from the centre follows the window: the numbers
// below are for a 512 px wide GUI, a maximised 2048 px window at scale 4, which `window` reports.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "joined", "command": "client.state"}
{"id": "window", "command": "client.info"}

// The screen, through the game rather than through a mouse. It opens on the Thirst page.
{"id": "openConfig", "command": "client.screen", "args": {"open": "config"}, "expect": {"result.screen": "com.thirstwastaken2.client.config.ThirstConfigScreen"}}
{"id": "rootDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "rootShot", "command": "client.capture", "args": {"name": "config-root"}}

// Sickness is the third tab. Its Normal tab, the fourth of five, holds the table for Normal:
// every grade's heading, its effect rows and the row that adds one. The strip shares out its width by
// name, so Normal spans about x = 90 to 159 from the centre.
{"id": "sickness", "command": "client.click", "args": {"x": 30, "y": 97, "button": 0, "from": "corner"}, "expect": {"result.taken": true}}
{"id": "sicknessDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "normal", "command": "client.click", "args": {"x": 124, "y": 81, "button": 0, "from": "top"}, "expect": {"result.taken": true}}
{"id": "normalDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "onSickness", "command": "client.info", "expect": {"result.screen": "com.thirstwastaken2.client.config.ThirstConfigScreen"}}
{"id": "sicknessShot", "command": "client.capture", "args": {"name": "config-sickness-normal"}}

// Item Values is the fifth tab.
{"id": "items", "command": "client.click", "args": {"x": 30, "y": 145, "button": 0, "from": "corner"}, "expect": {"result.taken": true}}
{"id": "itemsDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "onItems", "command": "client.info", "expect": {"result.screen": "com.thirstwastaken2.client.config.ThirstConfigScreen"}}
{"id": "itemsShot", "command": "client.capture", "args": {"name": "config-item-values"}}

// Matching, the second tab: the right half of the strip.
{"id": "matching", "command": "client.click", "args": {"x": 136, "y": 81, "button": 0, "from": "top"}, "expect": {"result.taken": true}}
{"id": "matchingDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "matchingShot", "command": "client.capture", "args": {"name": "config-item-matching"}}

// The Open button, below Matching's two settings. This opens the file. Everything after it is the proof that the
// call returned.
{"id": "openFile", "command": "client.click", "args": {"x": 183, "y": 151, "button": 0, "from": "top"}, "expect": {"result.taken": true}}
{"id": "opened", "command": "wait", "args": {"ticks": 20}}
{"id": "aliveAfterOpen", "command": "client.info", "expect": {"result.screen": "com.thirstwastaken2.client.config.ThirstConfigScreen"}}
{"id": "stateAfterOpen", "command": "client.state"}

// Done closes the screen.
{"id": "done", "command": "client.click", "args": {"x": 203, "y": -16, "button": 0, "from": "bottom"}, "expect": {"result.taken": true}}
{"id": "closedDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "closedByDone", "command": "client.info", "expect": {"result.screen": null}}

// And Cancel closes it too.
{"id": "reopen", "command": "client.screen", "args": {"open": "config"}, "expect": {"result.screen": "com.thirstwastaken2.client.config.ThirstConfigScreen"}}
{"id": "reopenDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "cancel", "command": "client.click", "args": {"x": 109, "y": -16, "button": 0, "from": "bottom"}, "expect": {"result.taken": true}}
{"id": "cancelDrawn", "command": "wait", "args": {"ticks": 10}}
{"id": "closedByCancel", "command": "client.info", "expect": {"result.screen": null}}
{"id": "aliveAtEnd", "command": "client.state"}
