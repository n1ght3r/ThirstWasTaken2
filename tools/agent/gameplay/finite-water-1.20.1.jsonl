{"id": "standA4", "command": "server.command", "args": {"command": "tp @p 0.5 201 -1.5 0 41"}}
{"id": "settleA4", "command": "wait", "args": {"ticks": 10}}
{"id": "bottle4", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:glass_bottle"}}
