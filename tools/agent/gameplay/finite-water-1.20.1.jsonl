// An empty copper canteen draws a bucket's three servings and takes the source.
{"id": "poolA5", "command": "server.command", "args": {"command": "setblock 0 200 0 minecraft:water"}}
{"id": "canteen5", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with thirstwastaken2:copper_canteen"}}
{"id": "use5", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "after5", "command": "wait", "args": {"ticks": 10}}
{"id": "three5", "command": "server.command", "args": {"command": "execute if entity @p[nbt={SelectedItem:{id:\"thirstwastaken2:copper_canteen\",tag:{thirstwastaken2:{servings:3}}}}]"}, "expect": {"result.messages.0": "Test passed, count: 1"}}
{"id": "taken5", "command": "server.command", "args": {"command": "execute if block 0 200 0 minecraft:air"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "canteen5Client", "command": "client.tooltip", "args": {"slot": "mainhand"}}
{"id": "capture5", "command": "client.capture", "args": {"name": "finite-water-taken"}}

// The rule back on: the client is told again, and the old behaviour returns.
{"id": "ruleBackOld", "command": "server.command", "args": {"command": "gamerule waterSourceConversion true"}}
{"id": "sync2", "command": "wait", "args": {"ticks": 40}}
