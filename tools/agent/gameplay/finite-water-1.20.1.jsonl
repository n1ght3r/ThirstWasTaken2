{"id": "after4", "command": "wait", "args": {"ticks": 10}}
{"id": "filled4", "command": "server.command", "args": {"command": "execute if entity @p[nbt={SelectedItem:{id:\"minecraft:potion\"}}]"}, "expect": {"result.messages.0": "Test passed, count: 1"}}
