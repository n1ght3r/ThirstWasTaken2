// Finite water in a real client (issue #45): with waterFillTakesSource at its default, Auto, scooping
// takes the source block only while the waterSourceConversion game rule is off. What only a client
// shows is that it agrees with the server: a bottle aimed at flowing water must stay a Glass Bottle in
// the client's own hand ("*Client" answers) when the server refuses it, which needs the server's
// answer synced down, within a second of the rule changing. This is finite-water.jsonl for 1.20.1, in NBT
// rather than item components. Run it unattended in a singleplayer world:
//     ./gradlew ":1.20.1:runClient" -Pagent=tools/agent/gameplay/finite-water-1.20.1.jsonl -Pquickplay=FiniteWaterAgent
// FiniteWaterAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.20.1 FiniteWaterAgent
// Then check it with
//     python tools/agent/drive.py run/1.20.1/agent/client tools/agent/gameplay/finite-water-1.20.1.jsonl --verify
// Pool A at 0 200 0 is one source; trench B at x 4 runs from a source at z 2 to flowing water at z 0.
// The player stands on stone south of each and looks 41 degrees down at its z 0 block.

{"id": "load", "command": "wait", "args": {"ticks": 300}}
{"id": "joined", "command": "client.state", "expect": {"result.alive": true}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "platform", "command": "server.command", "args": {"command": "fill -6 200 -6 6 200 6 minecraft:stone"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -6 201 -6 6 205 6 minecraft:air"}}
{"id": "standA", "command": "server.command", "args": {"command": "tp @p 0.5 201 -1.5 0 41"}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "poolA", "command": "server.command", "args": {"command": "setblock 0 200 0 minecraft:water"}}
{"id": "trenchB", "command": "server.command", "args": {"command": "fill 4 200 0 4 200 1 minecraft:air"}}
{"id": "sourceB", "command": "server.command", "args": {"command": "setblock 4 200 2 minecraft:water"}}
{"id": "ruleOnOld", "command": "server.command", "args": {"command": "gamerule waterSourceConversion true"}}
{"id": "flow", "command": "wait", "args": {"ticks": 40}}
{"id": "flowingB", "command": "server.command", "args": {"command": "execute if block 4 200 0 minecraft:water[level=2]"}, "expect": {"result.messages.0": "Test passed"}}

// The rule on: a bottle fills from flowing water and the source stays, as before.
{"id": "standB1", "command": "server.command", "args": {"command": "tp @p 4.5 201 -1.5 0 41"}}
{"id": "settleB1", "command": "wait", "args": {"ticks": 10}}
{"id": "bottle1", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:glass_bottle"}}
{"id": "use1", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "after1", "command": "wait", "args": {"ticks": 10}}
{"id": "filled1", "command": "server.command", "args": {"command": "execute if entity @p[nbt={SelectedItem:{id:\"minecraft:potion\"}}]"}, "expect": {"result.messages.0": "Test passed, count: 1"}}
{"id": "filled1Client", "command": "client.tooltip", "args": {"slot": "mainhand"}, "expect": {"result.lines.0": "Water Bottle"}}

// The rule off: the server says so to the client within a second.
{"id": "ruleOffOld", "command": "server.command", "args": {"command": "gamerule waterSourceConversion false"}}
{"id": "sync1", "command": "wait", "args": {"ticks": 40}}

// A bottle on flowing water stays empty, on the server and in the client's hand.
{"id": "bottle2", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:glass_bottle"}}
{"id": "use2", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "after2", "command": "wait", "args": {"ticks": 10}}
{"id": "empty2", "command": "server.command", "args": {"command": "execute if entity @p[nbt={SelectedItem:{id:\"minecraft:glass_bottle\"}}]"}, "expect": {"result.messages.0": "Test passed, count: 1"}}
{"id": "empty2Client", "command": "client.tooltip", "args": {"slot": "mainhand"}, "expect": {"result.lines.0": "Glass Bottle"}}
{"id": "flowLeft2", "command": "server.command", "args": {"command": "execute if block 4 200 0 minecraft:water"}, "expect": {"result.messages.0": "Test passed"}}

