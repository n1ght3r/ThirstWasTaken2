// Water bottles in the loot tables, and the boil_water advancement off a furnace and a smoker.
// Both are datapack shapes 26.3 changed: LootIntegration now builds its pool through
// Vanilla.lootPool, because 26.3 split the number providers and put each behind a Holder, and the
// smelting recipes carry a components ingredient.
//     ./gradlew ":26.3.x:runClient" -Pagent=tools/agent/gameplay/loot-and-boil.jsonl -Pquickplay=AgentPass
// AgentPass is a throwaway world; any world of the node's Minecraft version will do.
//
// The chests are rolled through their loot tables rather than by walking into a generated dungeon:
// the table is where the pool is added, and a real chest only rolls the same table once. Twelve
// rolls of each table, dropped away from the player so none of them is picked up; the pool gives
// water on half of them, so twelve is one chance in four thousand of a false failure. The Piglin
// pool is rarer, 3 in 40, so the barter table is rolled once per item already lying on the floor,
// which is well over a hundred rolls. Each "tag ... add" line answers with how many rolls that was.
//
// Every "execute if" line has to answer "Test passed". The furnace and the smoker each have to
// award boil_water when the player takes the result out, which is what vanilla's recipe_crafted
// trigger sees; setting the advancement by hand would prove nothing.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "joined", "command": "client.state"}
{"id": "float", "command": "server.command", "args": {"command": "effect give @p minecraft:slow_falling 600 0 true"}}
{"id": "up", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 -90 0"}}
{"id": "hold", "command": "server.command", "args": {"command": "forceload add -32 -32 32 48"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearSky", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "peaceful", "command": "server.command", "args": {"command": "difficulty peaceful"}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}

// Three floors: the player's, one for the chest rolls twenty blocks away, and one ten blocks under
// that for the barter rolls, so a selector around either can never see the other's drops.
{"id": "airHome", "command": "server.command", "args": {"command": "fill -6 200 -6 6 205 6 minecraft:air"}}
{"id": "floorHome", "command": "server.command", "args": {"command": "fill -6 199 -6 6 199 6 minecraft:stone"}}
{"id": "airChest", "command": "server.command", "args": {"command": "fill -6 200 14 6 205 26 minecraft:air"}}
{"id": "floorChest", "command": "server.command", "args": {"command": "fill -6 199 14 6 199 26 minecraft:stone"}}
{"id": "airBarter", "command": "server.command", "args": {"command": "fill -6 190 14 6 195 26 minecraft:air"}}
{"id": "floorBarter", "command": "server.command", "args": {"command": "fill -6 189 14 6 189 26 minecraft:stone"}}
{"id": "stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 -90 0"}}
{"id": "land", "command": "server.command", "args": {"command": "effect clear @p"}}
{"id": "empty", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "tidy", "command": "server.command", "args": {"command": "kill @e[type=item]"}}
{"id": "settle", "command": "wait", "args": {"ticks": 40}}

