{"id": "dungeonWater", "command": "server.command", "args": {"command": "execute positioned 0 201 20 if entity @e[type=item,distance=..6,nbt={Item:{id:\"minecraft:potion\",components:{\"thirstwastaken2:water_salty\":false}}}]"}}
{"id": "dungeonHasWater", "command": "server.command", "args": {"command": "execute positioned 0 201 20 if entity @e[type=item,distance=..6,limit=1,nbt={Item:{id:\"minecraft:potion\",components:{\"thirstwastaken2:water_salty\":false}}}]"}, "expect": {"result.messages.0": "Test passed. Count: 1"}}
{"id": "dungeonSample", "command": "server.command", "args": {"command": "execute positioned 0 201 20 run data get entity @e[type=item,distance=..6,limit=1,sort=nearest,nbt={Item:{id:\"minecraft:potion\"}}] Item.components"}}
{"id": "dungeonClear", "command": "server.command", "args": {"command": "kill @e[type=item]"}}

