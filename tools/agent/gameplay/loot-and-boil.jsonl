// Piglin bartering, once per item entity already on the floor and again for what that dropped: the
// shipwreck rolls leave a few dozen, so this is well over a hundred rolls of a pool that gives water
// 3 times in 40. The drops land ten blocks below the chest ones.
{"id": "barterOne", "command": "server.command", "args": {"command": "execute as @e[type=item] run loot spawn 0 191 20 loot minecraft:gameplay/piglin_bartering"}}
{"id": "barterSettle", "command": "wait", "args": {"ticks": 20}}
{"id": "barterTwo", "command": "server.command", "args": {"command": "execute as @e[type=item,tag=!rolled] run loot spawn 0 191 20 loot minecraft:gameplay/piglin_bartering"}}
{"id": "barterRest", "command": "wait", "args": {"ticks": 20}}
{"id": "barterRolled", "command": "server.command", "args": {"command": "tag @e[type=item] add bartered"}}
{"id": "barterWater", "command": "server.command", "args": {"command": "execute positioned 0 191 20 if entity @e[type=item,distance=..6,nbt={Item:{id:\"minecraft:potion\",components:{\"thirstwastaken2:water_salty\":false}}}]"}}
{"id": "barterHasWater", "command": "server.command", "args": {"command": "execute positioned 0 191 20 if entity @e[type=item,distance=..6,limit=1,nbt={Item:{id:\"minecraft:potion\",components:{\"thirstwastaken2:water_salty\":false}}}]"}, "expect": {"result.messages.0": "Test passed. Count: 1"}}
{"id": "barterSample", "command": "server.command", "args": {"command": "execute positioned 0 191 20 run data get entity @e[type=item,distance=..6,limit=1,sort=nearest,nbt={Item:{id:\"minecraft:potion\"}}] Item.components"}}
{"id": "loose", "command": "server.command", "args": {"command": "kill @e[type=item]"}}

// The boil_water advancement, by a furnace and then by a smoker. Vanilla's recipe_crafted trigger
// fires when the player takes the result out, so the result is taken through the open screen.
{"id": "revoke", "command": "server.command", "args": {"command": "advancement revoke @p only thirstwastaken2:boil_water"}}
{"id": "furnace", "command": "server.command", "args": {"command": "setblock 2 201 0 minecraft:furnace[facing=west,lit=false]"}}
{"id": "dirtyBottle", "command": "server.command", "args": {"command": "item replace block 2 201 0 container.0 with minecraft:potion[minecraft:potion_contents={potion:\"minecraft:water\"},thirstwastaken2:water_purity=0,thirstwastaken2:water_salty=false] 1"}}
{"id": "fuel", "command": "server.command", "args": {"command": "item replace block 2 201 0 container.1 with minecraft:coal 8"}}
{"id": "smelting", "command": "wait", "args": {"ticks": 280}}
{"id": "smelted", "command": "server.command", "args": {"command": "execute if data block 2 201 0 Items[{Slot:2b}]"}, "expect": {"result.messages.0": "Test passed. Count: 1"}}
{"id": "boiledClean", "command": "server.command", "args": {"command": "execute if data block 2 201 0 Items[{Slot:2b,components:{\"thirstwastaken2:water_purity\":2}}]"}, "expect": {"result.messages.0": "Test passed. Count: 1"}}
{"id": "lookFurnace", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 -90 0"}}
{"id": "aimed", "command": "wait", "args": {"ticks": 10}}
{"id": "openFurnace", "command": "client.hold", "args": {"keys": ["use"], "ticks": 4}}
{"id": "opened", "command": "wait", "args": {"ticks": 10}}
{"id": "furnaceMenu", "command": "client.slots"}
{"id": "takeResult", "command": "client.slot", "args": {"slot": 2, "action": "quick_move"}}
{"id": "taken", "command": "wait", "args": {"ticks": 10}}
{"id": "closeFurnace", "command": "client.screen", "args": {"open": "none"}}
{"id": "furnaceAward", "command": "server.command", "args": {"command": "execute if entity @p[advancements={thirstwastaken2:boil_water=true}]"}, "expect": {"result.messages.0": "Test passed. Count: 1"}}

// The same again with a smoker, from a revoked advancement, so the smoking recipes are proved too.
// Murky in, Clean out: heat stops at Clean whatever goes in, so purify_water_bottle_1_smoking gives
// the 2 a dirty bottle boils to.
{"id": "revokeAgain", "command": "server.command", "args": {"command": "advancement revoke @p only thirstwastaken2:boil_water"}}
{"id": "emptyAgain", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "noFurnace", "command": "server.command", "args": {"command": "setblock 2 201 0 minecraft:air"}}
{"id": "smoker", "command": "server.command", "args": {"command": "setblock 2 201 0 minecraft:smoker[facing=west,lit=false]"}}
{"id": "dirtyAgain", "command": "server.command", "args": {"command": "item replace block 2 201 0 container.0 with minecraft:potion[minecraft:potion_contents={potion:\"minecraft:water\"},thirstwastaken2:water_purity=1,thirstwastaken2:water_salty=false] 1"}}
{"id": "fuelAgain", "command": "server.command", "args": {"command": "item replace block 2 201 0 container.1 with minecraft:coal 8"}}
{"id": "smoking", "command": "wait", "args": {"ticks": 240}}
{"id": "smokedClean", "command": "server.command", "args": {"command": "execute if data block 2 201 0 Items[{Slot:2b,components:{\"thirstwastaken2:water_purity\":2}}]"}, "expect": {"result.messages.0": "Test passed. Count: 1"}}
{"id": "lookSmoker", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 -90 0"}}
{"id": "aimedAgain", "command": "wait", "args": {"ticks": 10}}
{"id": "openSmoker", "command": "client.hold", "args": {"keys": ["use"], "ticks": 4}}
{"id": "openedAgain", "command": "wait", "args": {"ticks": 10}}
{"id": "smokerMenu", "command": "client.slots"}
{"id": "takeSmoked", "command": "client.slot", "args": {"slot": 2, "action": "quick_move"}}
{"id": "takenAgain", "command": "wait", "args": {"ticks": 10}}
{"id": "closeSmoker", "command": "client.screen", "args": {"open": "none"}}
{"id": "smokerAward", "command": "server.command", "args": {"command": "execute if entity @p[advancements={thirstwastaken2:boil_water=true}]"}, "expect": {"result.messages.0": "Test passed. Count: 1"}}
{"id": "release", "command": "server.command", "args": {"command": "forceload remove all"}}
{"id": "shot", "command": "client.capture", "args": {"name": "loot-and-boil"}}
