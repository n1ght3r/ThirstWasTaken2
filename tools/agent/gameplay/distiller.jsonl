// The copper distiller in a real client: the five recipes load, a real right click places both halves
// the right way round, and the block and the five items render. Run it unattended in a singleplayer world:
//     ./gradlew ":<node>:runClient" -Pagent=tools/agent/gameplay/distiller.jsonl -Pquickplay=DistillerAgent
// DistillerAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> DistillerAgent
// Then python tools/agent/drive.py run/<node>/agent/client tools/agent/gameplay/distiller.jsonl --verify,
// read the five recipe lines in run/<node>/agent/client/out.jsonl, and look at the captures in run/<node>/agent/client/screenshots/: the placed machine from the front
// and from behind, with the distiller and its four parts in the hotbar; then a second one built in the
// world by real clicks, its parts alone, the boiler on its firebox beside a dry tub, and joined; then its
// GUI opened by a real click with an empty hand, distilling a bucket of sea water (client.slots names the
// menu and its slots). Placing,
// breaking, dropping and joining are gametests (DistillerGameTest); this covers what they cannot, the
// click and the drawing.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "joined", "command": "client.state", "expect": {"result.alive": true}}
{"id": "float", "command": "server.command", "args": {"command": "effect give @p minecraft:slow_falling 120 0 true"}}
{"id": "go", "command": "server.command", "args": {"command": "tp @p 0.5 200 -2.5 0 28"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clear", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -5 200 -5 7 206 5 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -5 199 -5 7 199 5 minecraft:grass_block"}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}

// The recipes load: giving each one says it unlocked one recipe (read out.jsonl; the message names
// the player, so it is not asserted).
{"id": "recipes", "command": "server.command", "args": {"command": "recipe give @p thirstwastaken2:copper_distiller"}}
{"id": "pipe", "command": "server.command", "args": {"command": "recipe give @p thirstwastaken2:copper_pipe"}}
{"id": "boilerRecipe", "command": "server.command", "args": {"command": "recipe give @p thirstwastaken2:distiller_boiler"}}
{"id": "tubRecipe", "command": "server.command", "args": {"command": "recipe give @p thirstwastaken2:cooling_tub"}}
{"id": "fireboxRecipe", "command": "server.command", "args": {"command": "recipe give @p thirstwastaken2:brick_firebox"}}

// The distiller in hand and its parts beside it, for the hotbar in the captures.
{"id": "hold", "command": "server.command", "args": {"command": "item replace entity @p hotbar.0 with thirstwastaken2:copper_distiller"}}
{"id": "slot1", "command": "server.command", "args": {"command": "item replace entity @p hotbar.1 with thirstwastaken2:copper_pipe 4"}}
{"id": "slot2", "command": "server.command", "args": {"command": "item replace entity @p hotbar.2 with thirstwastaken2:distiller_boiler"}}
{"id": "slot3", "command": "server.command", "args": {"command": "item replace entity @p hotbar.3 with thirstwastaken2:cooling_tub"}}
{"id": "slot4", "command": "server.command", "args": {"command": "item replace entity @p hotbar.4 with thirstwastaken2:brick_firebox"}}
{"id": "names", "command": "client.tooltip", "args": {"item": "thirstwastaken2:copper_distiller"}, "expect": {"result.lines.0": "Copper Distiller"}}
{"id": "pipeName", "command": "client.tooltip", "args": {"item": "thirstwastaken2:copper_pipe"}, "expect": {"result.lines.0": "Copper Pipe"}}

// Standing north of the floor block 0 199 0, looking south at its top: a right click places the boiler
// there, its front facing the player (north), and the tub to the player's right, west.
{"id": "aim", "command": "server.command", "args": {"command": "tp @p 0.5 200 -2.5 0 28"}}
{"id": "settleAim", "command": "wait", "args": {"ticks": 10}}
{"id": "press", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressed", "command": "wait", "args": {"ticks": 3}}
{"id": "release", "command": "client.key", "args": {"key": "use", "down": false}}
{"id": "placed", "command": "wait", "args": {"ticks": 10}}
{"id": "boiler", "command": "server.command", "args": {"command": "execute if block 0 200 0 thirstwastaken2:copper_distiller[facing=north,part=boiler]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "tub", "command": "server.command", "args": {"command": "execute if block -1 200 0 thirstwastaken2:copper_distiller[facing=north,part=tub]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "spent", "command": "server.command", "args": {"command": "execute unless items entity @p weapon.mainhand thirstwastaken2:copper_distiller"}, "expect": {"result.messages.0": "Test passed"}}

// Captures: from the front, a step back, and from behind for the chimney.
{"id": "front", "command": "server.command", "args": {"command": "tp @p 0.0 200 -3.5 0 20"}}
{"id": "settleFront", "command": "wait", "args": {"ticks": 40}}
{"id": "captureFront", "command": "client.capture", "args": {"name": "distiller-front"}}
{"id": "back", "command": "server.command", "args": {"command": "tp @p -0.5 200.5 3.5 180 25"}}
{"id": "settleBack", "command": "wait", "args": {"ticks": 40}}
{"id": "captureBack", "command": "client.capture", "args": {"name": "distiller-back"}}

// Built in the world, three blocks east: a firebox, then a boiler clicked onto its top, then a tub to its
// right, all placed looking south so they face north.
{"id": "firebox", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with thirstwastaken2:brick_firebox"}}
{"id": "aimFirebox", "command": "server.command", "args": {"command": "tp @p 4.5 200 -2.5 0 28"}}
{"id": "settleFirebox", "command": "wait", "args": {"ticks": 10}}
{"id": "pressFirebox", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressedFirebox", "command": "wait", "args": {"ticks": 3}}
{"id": "releaseFirebox", "command": "client.key", "args": {"key": "use", "down": false}}
{"id": "placedFirebox", "command": "wait", "args": {"ticks": 10}}
{"id": "fireboxPlaced", "command": "server.command", "args": {"command": "execute if block 4 200 0 thirstwastaken2:brick_firebox[facing=north]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "tubItem", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with thirstwastaken2:cooling_tub"}}
{"id": "aimTub", "command": "server.command", "args": {"command": "tp @p 3.5 200 -2.5 0 28"}}
{"id": "settleTub", "command": "wait", "args": {"ticks": 10}}
{"id": "pressTub", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressedTub", "command": "wait", "args": {"ticks": 3}}
{"id": "releaseTub", "command": "client.key", "args": {"key": "use", "down": false}}
{"id": "placedTub", "command": "wait", "args": {"ticks": 10}}
{"id": "tubPlaced", "command": "server.command", "args": {"command": "execute if block 3 200 0 thirstwastaken2:cooling_tub[facing=north,cooled=false]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "loneBoiler", "command": "server.command", "args": {"command": "setblock 6 200 0 thirstwastaken2:distiller_boiler[facing=north]"}}
{"id": "parts", "command": "server.command", "args": {"command": "tp @p 4.5 200.5 -3.5 0 20"}}
{"id": "settleParts", "command": "wait", "args": {"ticks": 40}}
{"id": "captureParts", "command": "client.capture", "args": {"name": "distiller-parts"}}
{"id": "loneBoilerGone", "command": "server.command", "args": {"command": "setblock 6 200 0 minecraft:air"}}

// The boiler onto the firebox's top: from close by and steep, so the ray meets the ledge's top and
// not its front.
{"id": "boilerItem", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with thirstwastaken2:distiller_boiler"}}
{"id": "aimBoiler", "command": "server.command", "args": {"command": "tp @p 4.5 200 -1.0 0 45"}}
{"id": "settleBoiler", "command": "wait", "args": {"ticks": 10}}
{"id": "pressBoiler", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressedBoiler", "command": "wait", "args": {"ticks": 3}}
{"id": "releaseBoiler", "command": "client.key", "args": {"key": "use", "down": false}}
{"id": "placedBoiler", "command": "wait", "args": {"ticks": 10}}
{"id": "merged", "command": "server.command", "args": {"command": "execute if block 4 200 0 thirstwastaken2:copper_distiller[facing=north,part=boiler,piped=false]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "unjoined", "command": "server.command", "args": {"command": "tp @p 4.0 200.5 -3.5 0 20"}}
{"id": "settleUnjoined", "command": "wait", "args": {"ticks": 40}}
{"id": "captureUnjoined", "command": "client.capture", "args": {"name": "distiller-unjoined"}}

// Coolant into the tub from a bucket, then the pipe on the tub joins the two.
{"id": "bucket", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:water_bucket"}}
{"id": "aimCoolant", "command": "server.command", "args": {"command": "tp @p 3.5 200 -2.5 0 28"}}
{"id": "settleCoolant", "command": "wait", "args": {"ticks": 10}}
{"id": "pressCoolant", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressedCoolant", "command": "wait", "args": {"ticks": 3}}
{"id": "releaseCoolant", "command": "client.key", "args": {"key": "use", "down": false}}
{"id": "poured", "command": "wait", "args": {"ticks": 10}}
{"id": "cooled", "command": "server.command", "args": {"command": "execute if block 3 200 0 thirstwastaken2:cooling_tub[cooled=true]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "emptied", "command": "server.command", "args": {"command": "execute unless items entity @p weapon.mainhand minecraft:water_bucket"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "pipeItem", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with thirstwastaken2:copper_pipe"}}
{"id": "pressPipe", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressedPipe", "command": "wait", "args": {"ticks": 3}}
{"id": "releasePipe", "command": "client.key", "args": {"key": "use", "down": false}}
{"id": "piped", "command": "wait", "args": {"ticks": 10}}
{"id": "joinedBoiler", "command": "server.command", "args": {"command": "execute if block 4 200 0 thirstwastaken2:copper_distiller[facing=north,part=boiler,piped=true]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "joinedTub", "command": "server.command", "args": {"command": "execute if block 3 200 0 thirstwastaken2:copper_distiller[facing=north,part=tub,piped=true,cooled=true]"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "pipeSpent", "command": "server.command", "args": {"command": "execute unless items entity @p weapon.mainhand thirstwastaken2:copper_pipe"}, "expect": {"result.messages.0": "Test passed"}}
{"id": "built", "command": "server.command", "args": {"command": "tp @p 4.0 200.5 -3.5 0 20"}}
{"id": "settleBuilt", "command": "wait", "args": {"ticks": 40}}
{"id": "captureBuilt", "command": "client.capture", "args": {"name": "distiller-built"}}

// The GUI: coal and a bucket of sea water into the machine built above, then a real click with an
// empty hand opens it. A few seconds in, the bucket has poured, the flame burns and the arrow fills.
{"id": "coal", "command": "server.command", "args": {"command": "item replace block 4 200 0 container.1 with minecraft:coal 4"}}
{"id": "seaWater", "command": "server.command", "args": {"command": "item replace block 4 200 0 container.0 with minecraft:water_bucket[thirstwastaken2:water_salty=true]"}}
{"id": "bottles", "command": "server.command", "args": {"command": "item replace block 4 200 0 container.2 with minecraft:glass_bottle 3"}}
{"id": "emptyHand", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:air"}}
{"id": "aimGui", "command": "server.command", "args": {"command": "tp @p 4.5 200 -2.5 0 28"}}
{"id": "settleGui", "command": "wait", "args": {"ticks": 10}}
{"id": "pressGui", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressedGui", "command": "wait", "args": {"ticks": 3}}
{"id": "releaseGui", "command": "client.key", "args": {"key": "use", "down": false}}
{"id": "opened", "command": "wait", "args": {"ticks": 100}}
{"id": "screen", "command": "client.screen"}
{"id": "slots", "command": "client.slots"}
{"id": "captureGui", "command": "client.capture", "args": {"name": "distiller-gui"}}
