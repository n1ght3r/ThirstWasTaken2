{"id": "plainsBack", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 8 207 7 minecraft:plains"}}

// A salty water cup poured into an empty cauldron leaves sea water (purity=5), not the Clean water an
// unset cauldron reads as, and hands back the cup. The player looks at the cauldron's body at pitch 30.
{"id": "emptyCauldron", "command": "server.command", "args": {"command": "setblock 0 200 2 minecraft:cauldron"}}
{"id": "pourClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "pourGive", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with bountifulfares:water_cup[thirstwastaken2:water_salty=true]"}}
{"id": "pourStand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "pourSettle", "command": "wait", "args": {"ticks": 10}}
{"id": "pourUse", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pourUsed", "command": "wait", "args": {"ticks": 10}}
{"id": "pourBlock", "command": "server.command", "args": {"command": "data get block 0 200 2"}}
{"id": "pourSalty", "command": "server.command", "args": {"command": "execute if block 0 200 2 minecraft:water_cauldron[purity=5]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pourCupBack", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand bountifulfares:jar"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

