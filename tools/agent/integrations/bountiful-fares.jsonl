// A cup scoops a swamp and an ocean source as a bottle does. Each pool's biome covers every cell around
// its own and a cell of neither lies between the two, as in miners-delight.jsonl.
{"id": "swampBiome", "command": "server.command", "args": {"command": "fillbiome -8 192 -8 3 207 7 minecraft:swamp"}}
{"id": "swampPool", "command": "server.command", "args": {"command": "fill -3 199 -1 -3 199 1 minecraft:water"}}
{"id": "oceanBiome", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 -13 207 7 minecraft:ocean"}}
{"id": "oceanPool", "command": "server.command", "args": {"command": "fill -19 199 -1 -19 199 1 minecraft:water"}}
{"id": "clearS", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "cupS", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with bountifulfares:jar"}}
{"id": "standS", "command": "server.command", "args": {"command": "tp @p -2.5 200 -2.5 0 45"}}
{"id": "settleS", "command": "wait", "args": {"ticks": 20}}
{"id": "scoopS", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "scoopedS", "command": "wait", "args": {"ticks": 10}}
{"id": "itemS", "command": "server.command", "args": {"command": "data get entity @p SelectedItem"}}
{"id": "swampDirty", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand bountifulfares:water_cup[thirstwastaken2:water_purity=0]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "clearO", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "cupO", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with bountifulfares:jar"}}
