// Crafting through a Crafter, which asks the same recipe matcher a crafting table does: a Dirty water cup
// and tea leaves make green tea, a salty one makes nothing.
{"id": "fresh_tea_crafter", "command": "server.command", "args": {"command": "setblock 0 200 4 minecraft:crafter[orientation=north_up]"}}
{"id": "fresh_tea_chest", "command": "server.command", "args": {"command": "setblock 0 200 3 minecraft:chest[facing=south]"}}
{"id": "fresh_tea_slot4", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.4 with bountifulfares:tea_leaves 1"}}
{"id": "fresh_tea_slot7", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.7 with bountifulfares:water_cup[thirstwastaken2:water_purity=0,thirstwastaken2:water_salty=false] 1"}}
