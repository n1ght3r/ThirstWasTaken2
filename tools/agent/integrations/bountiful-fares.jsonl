// Bountiful Fares in a real client, step 6 of its integration plan
// (docs/dev/integration/cooking/BOUNTIFUL-FARES-INTEGRATION.md). What it proves: every id ThirstConfig
// lists for the mod exists; a cup scooping a swamp or ocean source is stamped with that water's grade
// (CupItemMixin); a salty water cup poured into an empty cauldron leaves sea water, and a cup drawn from
// a Dirty cauldron comes out Dirty; a water cup pours into and draws from a hanging pot one serving at a
// time; the Fermentation Vessel refuses sea water and takes fresh; a tea crafts from a fresh water cup
// and not from a salty one, through a Crafter; and a Pure water cup and a tea restore what they should.
// Runs on 1.21.1 and 1.21.1-neoforge, with Bountiful Fares' two runClientMod lines uncommented in that
// node's script. Run it unattended:
//     ./gradlew ":1.21.1:runClient" -Pagent=tools/agent/integrations/bountiful-fares.jsonl -Pquickplay=FaresAgent
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/bountiful-fares.jsonl -Pquickplay=FaresAgent
// FaresAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> FaresAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/integrations/bountiful-fares.jsonl --verify --max-age 15

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -24 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 900 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 60"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -24 200 -8 8 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -24 199 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 8 207 7 minecraft:plains"}}

