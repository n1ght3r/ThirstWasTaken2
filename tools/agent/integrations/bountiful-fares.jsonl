{"id": "settleO", "command": "wait", "args": {"ticks": 20}}
{"id": "scoopO", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "scoopedO", "command": "wait", "args": {"ticks": 10}}
{"id": "itemO", "command": "server.command", "args": {"command": "data get entity @p SelectedItem"}}
{"id": "oceanSalty", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand bountifulfares:water_cup[thirstwastaken2:water_salty=true]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
