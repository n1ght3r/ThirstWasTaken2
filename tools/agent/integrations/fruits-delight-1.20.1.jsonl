// fruits-delight.jsonl for Minecraft 1.20.1, on 1.20.1-forge, Fruits Delight's only 1.20.1 build (1.1.3,
// L2 Library nested). Water is the potion's NBT, and an inventory is searched with `execute if data`,
// since 1.20.1 has no `execute if items`; the checks and their order are the same.
//     python tools/agent/new_world.py 1.20.1-forge FruitsAgent
//     ./gradlew ":1.20.1-forge:runClient" -Pagent=tools/agent/integrations/fruits-delight-1.20.1.jsonl -Pquickplay=FruitsAgent
//     python tools/agent/drive.py run/1.20.1-forge/agent/client tools/agent/integrations/fruits-delight-1.20.1.jsonl --verify --max-age 15
//
// The rest of the header of fruits-delight.jsonl holds here: its juice takes the water bottle through
// L2 Library's potion ingredient, which WaterBottleIngredientMixin targets on 1.20.1.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 600 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 60"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -8 199 -8 8 199 8 minecraft:stone"}}

