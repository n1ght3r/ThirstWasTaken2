// Orange juice from a plain, a Dirty and a sea water bottle. Each is crafted on its own, and taking the
// result proves the recipe accepted the bottle. The plain and the Dirty one do; the sea water one does
// not (WaterBottleIngredientMixin). No glass bottle comes back, as with vanilla's own water bottle recipes.
{"id": "table", "command": "server.command", "args": {"command": "setblock 0 200 2 minecraft:crafting_table"}}
{"id": "plain_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "plain_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 45"}}
{"id": "plain_give9", "command": "server.command", "args": {"command": "item replace entity @p container.9 with minecraft:potion{Potion:\"minecraft:water\"}"}}
{"id": "plain_give10", "command": "server.command", "args": {"command": "item replace entity @p container.10 with minecraft:sugar"}}
{"id": "plain_give11", "command": "server.command", "args": {"command": "item replace entity @p container.11 with fruitsdelight:orange 2"}}
{"id": "plain_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "plain_open", "command": "client.hold", "args": {"keys": ["use"], "ticks": 5}}
{"id": "plain_opened", "command": "wait", "args": {"ticks": 10}}
{"id": "plain_take0", "command": "client.slot", "args": {"inventory": 9}}
{"id": "plain_put0", "command": "client.slot", "args": {"slot": 1}}
{"id": "plain_take1", "command": "client.slot", "args": {"inventory": 10}}
{"id": "plain_put1", "command": "client.slot", "args": {"slot": 2}}
{"id": "plain_take2", "command": "client.slot", "args": {"inventory": 11}}
{"id": "plain_put2a", "command": "client.slot", "args": {"slot": 3, "button": 1}}
{"id": "plain_put2b", "command": "client.slot", "args": {"slot": 4, "button": 1}}
{"id": "plain_grid", "command": "client.slots"}
{"id": "plain_result", "command": "client.slot", "args": {"slot": 0, "action": "quick_move"}}
{"id": "plain_close", "command": "client.screen", "args": {"open": "none"}}
{"id": "plain_juice", "command": "server.command", "args": {"command": "execute if data entity @p Inventory[{id:\"fruitsdelight:orange_juice\"}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "plain_bottleBack", "command": "server.command", "args": {"command": "execute if data entity @p Inventory[{id:\"minecraft:glass_bottle\"}]"}}
