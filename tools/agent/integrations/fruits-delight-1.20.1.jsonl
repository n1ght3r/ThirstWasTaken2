// Drinking: orange juice restores 8, an apple jello 3, an orange 2, from thirst 4 and quenched 0.
{"id": "drink_juice_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_juice_hunger", "command": "server.command", "args": {"command": "effect give @p minecraft:hunger 2 255 true"}}
{"id": "drink_juice_hungry", "command": "wait", "args": {"ticks": 60}}
