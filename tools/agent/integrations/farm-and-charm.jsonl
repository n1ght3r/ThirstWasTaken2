// Timber Well. Foot on 0 200 2 facing east, head on 1 200 2, top on 1 201 2, set full (level 3) so no
// pumping is needed. The groundwater is the source on 0 197 2, inside the box the well scans.
{"id": "groundwater", "command": "server.command", "args": {"command": "setblock 0 197 2 minecraft:water"}}
// Swamp: stagnant water, Dirty.
{"id": "well_swamp_biome", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 8 212 8 minecraft:swamp"}}
{"id": "well_swamp_well_foot", "command": "server.command", "args": {"command": "setblock 0 200 2 farm_and_charm:timber_well[facing=east,part=foot,level=3]"}}
