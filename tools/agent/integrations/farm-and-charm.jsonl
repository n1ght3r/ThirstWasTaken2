// Let's Do: Farm & Charm and Candlelight in a real client: the investigation and the check of both
// integration plans (docs/dev/integration/lets-do/FARM-AND-CHARM-INTEGRATION.md, CANDLELIGHT-INTEGRATION.md).
// What it proves: every id ThirstConfig lists for the two mods exists; a bucket drawn from a Timber Well
// carries the grade of the groundwater under it (swamp Dirty, plains Murky, beach sea water) or of rain
// when there is none; a Water Trough refuses sea water and gives Murky water whatever went in; a
// Candlelight kitchen sink refuses sea water and gives Murky bottles and buckets; the Cooking Pot,
// Candlelight's Large Cooking Pot and the Stove cook with a plain water bucket and not with a salty one;
// and the teas and dishes restore what ThirstConfig says. Runs on both 1.21.1 nodes. Run it unattended:
//     ./gradlew ":1.21.1:runClient" -Pagent=tools/agent/integrations/farm-and-charm.jsonl -Pquickplay=FarmCharmAgent
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/farm-and-charm.jsonl -Pquickplay=FarmCharmAgent -PwithoutOptional=cold-sweat
// FarmCharmAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> FarmCharmAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/integrations/farm-and-charm.jsonl --verify --max-age 15
//
// Everything happens on a stone floor at y 199 over a stone box down to y 194, where one water source
// block is the groundwater. The player stands at 0.5 200 0.5 looking south at pitch 30, at the block on
// 0 200 2. Biomes are set with /fillbiome, which the well's sample reads on the server.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 30"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 210 8 minecraft:air"}}
{"id": "box", "command": "server.command", "args": {"command": "fill -8 194 -8 8 199 8 minecraft:stone"}}

