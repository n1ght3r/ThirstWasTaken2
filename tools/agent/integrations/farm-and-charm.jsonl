{"id": "well_swamp_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:bucket"}}
{"id": "well_swamp_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "well_swamp_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "well_swamp_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "well_swamp_used", "command": "wait", "args": {"ticks": 10}}
{"id": "well_swamp_bucket", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minecraft:water_bucket[thirstwastaken2:water_purity=0]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
