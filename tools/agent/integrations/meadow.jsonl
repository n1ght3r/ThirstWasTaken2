// Let's Do: Meadow in a real client, step 6 of its integration plan
// (docs/dev/integration/lets-do/MEADOW-INTEGRATION.md). What it proves: every id ThirstConfig lists for
// the mod exists, and its water blocks; a wooden bucket scooping a swamp or ocean source is stamped with
// that water's grade (WoodenBucketMixin); a salty wooden water bucket poured into a vanilla cauldron
// leaves sea water, and a wooden bucket drawn from a Dirty cauldron comes out Dirty; a wooden water
// bucket pours into and draws from a hanging pot; a wooden cauldron refuses sea water, and a bottle or a
// wooden bucket drawn from it is Murky whatever went in (AbstractCauldronBlockMixin, ItemUtilsMixin); the
// Cooking Pot refuses sea water and takes fresh (CookingCauldronBlockEntityMixin); a wooden milk bucket
// restores what a milk bucket does.
// Runs on 1.21.1 and 1.21.1-neoforge, with Meadow's runClientMod lines uncommented in that node's
// script (two on Fabric, one on NeoForge). Run it unattended:
//     ./gradlew ":1.21.1:runClient" -Pagent=tools/agent/integrations/meadow.jsonl -Pquickplay=MeadowAgent
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/meadow.jsonl -Pquickplay=MeadowAgent
// MeadowAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> MeadowAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/integrations/meadow.jsonl --verify --max-age 15

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -24 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 900 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 60"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -24 200 -8 8 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -24 199 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 8 207 7 minecraft:plains"}}

