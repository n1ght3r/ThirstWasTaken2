// Let's Do: Vinery in a real client. Vinery has no integration directory: its juices, wines and fruit
// are ThirstConfig ids (vineryDrinks, vineryFoods), and it holds no water. What this proves: every id
// ThirstConfig lists for the mod exists, and a cider, a wine and a grape restore what ThirstConfig
// says. Vinery 1.5.4's juices cannot be drunk on Fabric, with or without this mod: its
// GrapejuiceBottleItem declares the pre 1.21 getUseDuration(ItemStack), which Fabric never calls, so the
// use never finishes. NeoForge still calls it, and there a juice drinks in two seconds. The juice case
// is recorded, not checked: read drink_red_grapejuice_state by hand. Fabric: 4, 0 and the juice still
// in hand. NeoForge: 12, 12 (8, 13 from 4, quenched held at the thirst). When Fabric matches NeoForge,
// Vinery has fixed it: drop the Fabric note from docs/docs/integrations/vinery.md.
// Runs on both 1.21.1 nodes, with Vinery's runClientMod line uncommented. Run it unattended:
//     ./gradlew ":1.21.1:runClient" -Pagent=tools/agent/integrations/vinery.jsonl -Pquickplay=LetsDoAgent
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/vinery.jsonl -Pquickplay=LetsDoAgent -PwithoutOptional=cold-sweat
// LetsDoAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> LetsDoAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/integrations/vinery.jsonl --verify --max-age 15
//
// Everything happens on a stone floor at y 199, biome plains. The player stands at 0.5 200 0.5.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 30"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 210 8 minecraft:air"}}
{"id": "box", "command": "server.command", "args": {"command": "fill -8 194 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 8 212 8 minecraft:plains"}}

