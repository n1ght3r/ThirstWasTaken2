// Drinking and eating from thirst 4, quenched 0, looking up so nothing is placed: a cider is 5, 6, a
// wine 3, 4, a grape 1, 2, and a juice as above. Hunger first, so the grape can be eaten.
{"id": "drink_red_grapejuice_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_red_grapejuice_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 -30"}}
{"id": "drink_red_grapejuice_hunger", "command": "server.command", "args": {"command": "effect give @p minecraft:hunger 2 255 true"}}
{"id": "drink_red_grapejuice_hungry", "command": "wait", "args": {"ticks": 60}}
{"id": "drink_red_grapejuice_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink_red_grapejuice_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with vinery:red_grapejuice"}}
{"id": "drink_red_grapejuice_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_red_grapejuice_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
{"id": "drink_red_grapejuice_done", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_red_grapejuice_state", "command": "client.state"}
