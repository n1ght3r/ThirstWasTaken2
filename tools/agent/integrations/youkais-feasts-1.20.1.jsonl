// Drinking: Green Tea restores 6, Miso Soup 6, from thirst 4 and quenched 0. Looking up, so the soup is
// eaten rather than placed.
{"id": "drink_tea_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_tea_hunger", "command": "server.command", "args": {"command": "effect give @p minecraft:hunger 2 255 true"}}
{"id": "drink_tea_hungry", "command": "wait", "args": {"ticks": 60}}
{"id": "drink_tea_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink_tea_look", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 -90"}}
{"id": "drink_tea_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with youkaisfeasts:green_tea"}}
{"id": "drink_tea_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_tea_tooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}
{"id": "drink_tea_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
{"id": "drink_tea_done", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_tea_state", "command": "client.state", "expect": {"result.thirst": 10}}
{"id": "drink_soup_clear", "command": "server.command", "args": {"command": "clear @p"}}
