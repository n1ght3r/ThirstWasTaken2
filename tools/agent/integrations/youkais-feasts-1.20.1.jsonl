// Bamboo Mizuyokan in Farmer's Delight's Cooking Pot, on a magma block, from a plain and a sea water
// bottle loaded into its inventory. Its water is L2's potion ingredient: the plain one cooks, the sea
// water one does not (WaterBottleIngredientMixin). The meal sits in slot 6 with no saucer to take it.
{"id": "mizu_plain_heat", "command": "server.command", "args": {"command": "setblock 4 199 4 minecraft:magma_block"}}
{"id": "mizu_plain_place", "command": "server.command", "args": {"command": "setblock 4 200 4 farmersdelight:cooking_pot"}}
{"id": "mizu_plain_load", "command": "server.command", "args": {"command": "data merge block 4 200 4 {Inventory:{Size:9,Items:[{Slot:0,id:\"youkaisfeasts:redbean\",Count:1b},{Slot:1,id:\"minecraft:potion\",Count:1b,tag:{Potion:\"minecraft:water\"}},{Slot:2,id:\"minecraft:bamboo\",Count:1b},{Slot:3,id:\"minecraft:sugar\",Count:1b}]}}"}}
{"id": "mizu_plain_cook", "command": "wait", "args": {"ticks": 300}}
{"id": "mizu_plain_inventory", "command": "server.command", "args": {"command": "data get block 4 200 4 Inventory"}}
{"id": "mizu_plain_meal", "command": "server.command", "args": {"command": "execute if data block 4 200 4 Inventory.Items[{Slot:6,id:\"youkaisfeasts:bamboo_mizuyokan\"}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "mizu_plain_gone", "command": "server.command", "args": {"command": "setblock 4 200 4 minecraft:air"}}
{"id": "mizu_salty_heat", "command": "server.command", "args": {"command": "setblock 4 199 4 minecraft:magma_block"}}
{"id": "mizu_salty_place", "command": "server.command", "args": {"command": "setblock 4 200 4 farmersdelight:cooking_pot"}}
{"id": "mizu_salty_load", "command": "server.command", "args": {"command": "data merge block 4 200 4 {Inventory:{Size:9,Items:[{Slot:0,id:\"youkaisfeasts:redbean\",Count:1b},{Slot:1,id:\"minecraft:potion\",Count:1b,tag:{Potion:\"minecraft:water\",thirstwastaken2:{salty:1b}}},{Slot:2,id:\"minecraft:bamboo\",Count:1b},{Slot:3,id:\"minecraft:sugar\",Count:1b}]}}"}}
