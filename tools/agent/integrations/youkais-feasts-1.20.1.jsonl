// Youkais' Feasts in a real client, the in-game check of its integration plan's step 4, on 1.20.1-forge:
// whether a plain, a Dirty and a sea water bucket go into a Kettle and an open Fermentation Tank, whether a
// water bottle of each starts a soup in a Small Iron Pot, whether a sea water bottle cooks Bamboo
// Mizuyokan in Farmer's Delight's Cooking Pot, that every id ThirstConfig lists for the mod exists, and
// that its tea and soup restore their values. Needs the mod's runClientMod line on. Run it unattended in
// a singleplayer world:
//     ./gradlew ":1.20.1-forge:runClient" -Pagent=tools/agent/integrations/youkais-feasts-1.20.1.jsonl -Pquickplay=YoukaiAgent -PwithoutOptional=cold-sweat
// YoukaiAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.20.1-forge YoukaiAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/1.20.1-forge/agent/client tools/agent/integrations/youkais-feasts-1.20.1.jsonl --verify --max-age 15
//
// A bucket poured in comes back empty in the hand; a refused one stays full. The kettle, tank and iron pot
// stand at 0 200 1, looked at from 0.5 200 0.5 at pitch 50, onto the top of the kettle's short body; a
// missed ray would pour the bucket onto the floor and pass for a fill, so each case starts in clean air.
{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 900 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 60"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -8 199 -8 8 199 8 minecraft:stone"}}

