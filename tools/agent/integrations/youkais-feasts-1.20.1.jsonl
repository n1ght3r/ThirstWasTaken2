{"id": "drink_soup_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with youkaisfeasts:miso_soup"}}
{"id": "drink_soup_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_soup_tooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}
{"id": "drink_soup_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
