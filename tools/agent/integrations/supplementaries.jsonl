// Supplementaries and Moonlight Lib in a real client: water keeps its grade through a jar, sea water
// stays sea water, a goblet of water can be drunk, a faucet keeps what a cauldron or a hanging pot
// holds and samples the water it draws out of the world, and the mod own terracotta bowl is a
// container Moonlight knows. Only the two 1.21.1 nodes have them on the runClient classpath. Run it
// unattended in a singleplayer world:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/supplementaries.jsonl -Pquickplay=SupplementariesAgent
//     ./gradlew ":1.21.1:runClient" -Pagent=tools/agent/integrations/supplementaries.jsonl -Pquickplay=SupplementariesAgent
// SupplementariesAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> SupplementariesAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/integrations/supplementaries.jsonl --verify
// Every "execute" line has to say "Test passed", and the captures in
// run/<node>/agent/client/screenshots/ show the scene.
//
// The blocks are right clicked by standing on them and looking straight down, which is the one aim a
// script cannot miss. World edits go through server.command, which runs with the console's
// permissions, so the world does not need cheats on.
//
// The scene is force loaded because it is nowhere near spawn.
//
// The player is addressed by selector throughout: a Fabric dev client calls its player Player<NN>
// and a NeoForge one calls it Dev, so a name would only ever fit one of the two nodes.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "arrived", "command": "client.state"}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}

// Go to the scene: a world may spawn the player far from it, where nothing is loaded.
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -9 -6 9 6"}}
{"id": "float", "command": "server.command", "args": {"command": "effect give @p minecraft:slow_falling 600 0 true"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 600 4 true"}}
{"id": "view", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 90"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -13 200 -6 13 206 6 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -13 199 -6 13 199 6 minecraft:stone"}}
// Plains everywhere, so the water sampled below scores the same in both worlds: 55 for an ordinary
// biome, less 5 for being above y 100, which is grade 1. That is not defaultPurity, so the assertion
// tells a real sample apart from the fallback.
{"id": "biome", "command": "server.command", "args": {"command": "fillbiome -13 199 -6 13 206 6 minecraft:plains"}}

// Two faucets, started first so they run while the jars are being used. Each has its source cauldron
// behind it and its target cauldron below. A faucet is open when exactly one of powered and enabled
// holds, and nothing here is wired to redstone, so enabled alone opens it.
//
// The first drains a full dirty cauldron into an empty one: without the integration the water arrives
// plain, which reads as defaultPurity, Clean.
{"id": "source1", "command": "server.command", "args": {"command": "setblock -2 201 0 minecraft:water_cauldron[level=3,purity=1]"}}
{"id": "target1", "command": "server.command", "args": {"command": "setblock -3 200 0 minecraft:cauldron"}}
{"id": "faucet1", "command": "server.command", "args": {"command": "setblock -3 201 0 supplementaries:faucet[facing=west,enabled=true,powered=false]"}}
// The second pours pure water into a dirty cauldron: the cauldron keeps the worse of the two, as it
// does when a container is poured in by hand.
{"id": "source2", "command": "server.command", "args": {"command": "setblock -6 201 0 minecraft:water_cauldron[level=2,purity=4]"}}
{"id": "target2", "command": "server.command", "args": {"command": "setblock -7 200 0 minecraft:water_cauldron[level=1,purity=1]"}}
{"id": "faucet2", "command": "server.command", "args": {"command": "setblock -7 201 0 supplementaries:faucet[facing=west,enabled=true,powered=false]"}}

// A faucet over a water source block in the world. Supplementaries offers plain water, so without
// the sampling the cauldron below would read defaultPurity, Clean, which is purity 3 as a cauldron
// stores it. Sampled, plains water is grade 1, which is purity 2. The source is boxed in so its
// flow stays put; a source block placed with setblock stays a source whatever it spills.
{"id": "poolFloor", "command": "server.command", "args": {"command": "setblock -10 200 0 minecraft:stone"}}
{"id": "poolWalls", "command": "server.command", "args": {"command": "fill -10 201 -1 -10 201 1 minecraft:stone"}}
{"id": "poolBack", "command": "server.command", "args": {"command": "setblock -9 201 0 minecraft:stone"}}
{"id": "poolLid", "command": "server.command", "args": {"command": "setblock -10 202 0 minecraft:stone"}}
{"id": "pool", "command": "server.command", "args": {"command": "setblock -10 201 0 minecraft:water"}}
{"id": "target3", "command": "server.command", "args": {"command": "setblock -11 200 0 minecraft:cauldron"}}
{"id": "faucet3", "command": "server.command", "args": {"command": "setblock -11 201 0 supplementaries:faucet[facing=west,enabled=true,powered=false]"}}

// A faucet draining a hanging pot into a cauldron, and another filling a pot from one. The pot is
// the mod own water block and keeps its grade in a blockstate, the way a cauldron does. A pot stands
// on its legs a block up, with the block under it clear and the floor below that, so the first sits
// over the gap above the floor and the second one block higher, its faucet and source with it.
{"id": "potFull", "command": "server.command", "args": {"command": "setblock 9 201 0 thirstwastaken2:copper_hanging_pot[hanging=false,axis=z,level=2,purity=1]"}}
{"id": "target4", "command": "server.command", "args": {"command": "setblock 8 200 0 minecraft:cauldron"}}
{"id": "faucet4", "command": "server.command", "args": {"command": "setblock 8 201 0 supplementaries:faucet[facing=west,enabled=true,powered=false]"}}
{"id": "source5", "command": "server.command", "args": {"command": "setblock 12 202 0 minecraft:water_cauldron[level=3,purity=2]"}}
{"id": "potEmpty", "command": "server.command", "args": {"command": "setblock 11 201 0 thirstwastaken2:copper_hanging_pot[hanging=false,axis=z,level=0]"}}
{"id": "faucet5", "command": "server.command", "args": {"command": "setblock 11 202 0 supplementaries:faucet[facing=west,enabled=true,powered=false]"}}

// A dirty water bottle poured into a jar and drawn back out is still dirty.
{"id": "jarA", "command": "server.command", "args": {"command": "setblock 0 200 0 supplementaries:jar"}}
{"id": "clearA", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "dirtyBottle", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:potion[minecraft:potion_contents={potion:\"minecraft:water\"},thirstwastaken2:water_purity=0,thirstwastaken2:water_salty=false]"}}
{"id": "standA", "command": "server.command", "args": {"command": "tp @p 0.5 201 0.5 0 90"}}
{"id": "settleA", "command": "wait", "args": {"ticks": 20}}
{"id": "pourA", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pouredA", "command": "wait", "args": {"ticks": 10}}
{"id": "jarAHolds", "command": "server.command", "args": {"command": "data get block 0 200 0 fluid"}}
{"id": "jarAGraded", "command": "server.command", "args": {"command": "execute if data block 0 200 0 {fluid:{id:\"moonlight:water\",components:{\"thirstwastaken2:water_purity\":0}}}"}}
{"id": "emptiedA", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minecraft:glass_bottle"}}
{"id": "drawA", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "drawnA", "command": "wait", "args": {"ticks": 10}}
{"id": "stillDirty", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minecraft:potion[thirstwastaken2:water_purity=0,thirstwastaken2:water_salty=false]"}}

// Sea water is a water bottle with no grade at all. Without the integration Moonlight reads it as an
// ordinary water bottle, so a jar turned the sea drinkable.
{"id": "jarB", "command": "server.command", "args": {"command": "setblock 2 200 0 supplementaries:jar"}}
{"id": "clearB", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "saltyBottle", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:potion[minecraft:potion_contents={potion:\"minecraft:water\"},thirstwastaken2:water_salty=true]"}}
{"id": "standB", "command": "server.command", "args": {"command": "tp @p 2.5 201 0.5 0 90"}}
{"id": "settleB", "command": "wait", "args": {"ticks": 20}}
{"id": "pourB", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pouredB", "command": "wait", "args": {"ticks": 10}}
{"id": "jarBHolds", "command": "server.command", "args": {"command": "data get block 2 200 0 fluid"}}
{"id": "jarBSalty", "command": "server.command", "args": {"command": "execute if data block 2 200 0 {fluid:{id:\"moonlight:water\",components:{\"thirstwastaken2:water_salty\":1b}}}"}}
{"id": "emptiedB", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minecraft:glass_bottle"}}
{"id": "drawB", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "drawnB", "command": "wait", "args": {"ticks": 10}}
{"id": "stillSalty", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minecraft:potion[thirstwastaken2:water_salty=true]"}}
{"id": "noGrade", "command": "server.command", "args": {"command": "execute unless items entity @p weapon.mainhand minecraft:potion[thirstwastaken2:water_purity=0]"}}

// A goblet of water can be drunk, which Supplementaries alone cannot do: Moonlight only drinks a fluid
// that names a food item, and water names none.
{"id": "goblet", "command": "server.command", "args": {"command": "setblock 4 200 0 supplementaries:goblet"}}
{"id": "clearC", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "pureBottle", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:potion[minecraft:potion_contents={potion:\"minecraft:water\"},thirstwastaken2:water_purity=3,thirstwastaken2:water_salty=false]"}}
{"id": "standC", "command": "server.command", "args": {"command": "tp @p 4.5 201 0.5 0 90"}}
{"id": "settleC", "command": "wait", "args": {"ticks": 20}}
{"id": "pourC", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pouredC", "command": "wait", "args": {"ticks": 10}}
{"id": "gobletHolds", "command": "server.command", "args": {"command": "data get block 4 200 0 fluid"}}
{"id": "gobletFull", "command": "server.command", "args": {"command": "execute if data block 4 200 0 {fluid:{id:\"moonlight:water\",components:{\"thirstwastaken2:water_purity\":3}}}"}}
{"id": "emptyHand", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "thirsty", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "drunk", "command": "wait", "args": {"ticks": 20}}
{"id": "quenched", "command": "server.players", "checks": [{"left": "result.players.0.thirst", "op": "gt", "value": 4}]}
{"id": "gobletEmpty", "command": "server.command", "args": {"command": "execute if data block 4 200 0 {fluid:{count:0}}"}}

// The mod own terracotta bowl is a container Moonlight knows, so a jar fills and empties it the way
// it does a vanilla bottle. Moonlight is told about it where it adds the buckets of its own fluids.
{"id": "jarC", "command": "server.command", "args": {"command": "setblock 6 200 0 supplementaries:jar"}}
{"id": "clearD", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "murkyBowl", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with thirstwastaken2:terracotta_water_bowl[thirstwastaken2:water_purity=1,thirstwastaken2:water_salty=false]"}}
{"id": "standD", "command": "server.command", "args": {"command": "tp @p 6.5 201 0.5 0 90"}}
{"id": "settleD", "command": "wait", "args": {"ticks": 20}}
{"id": "pourD", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pouredD", "command": "wait", "args": {"ticks": 10}}
{"id": "jarCHolds", "command": "server.command", "args": {"command": "data get block 6 200 0 fluid"}}
{"id": "jarCGraded", "command": "server.command", "args": {"command": "execute if data block 6 200 0 {fluid:{id:\"moonlight:water\",components:{\"thirstwastaken2:water_purity\":1}}}"}}
{"id": "emptiedD", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand thirstwastaken2:terracotta_bowl"}}
{"id": "drawD", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "drawnD", "command": "wait", "args": {"ticks": 10}}
{"id": "bowlRefilled", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand thirstwastaken2:terracotta_water_bowl[thirstwastaken2:water_purity=1,thirstwastaken2:water_salty=false]"}}

// What a player sees of all this. A jar broken back into an item keeps what it held, so its tooltip
// is the mod own grade line under Supplementaries own fluid line; the water in a placed jar is tinted
// by grade rather than by biome; and Jade names the grade of whatever jar or goblet is under the
// crosshair, through the same overlay entry world water and cauldrons already use.
//
// Jar A was emptied again by the case above, so it is filled straight back up before it is broken.
{"id": "clearE", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "refillJarA", "command": "server.command", "args": {"command": "data merge block 0 200 0 {fluid:{id:\"moonlight:water\",count:4,components:{\"thirstwastaken2:water_purity\":0}}}"}}
{"id": "breakJarA", "command": "server.command", "args": {"command": "loot give @p mine 0 200 0"}}
{"id": "looted", "command": "wait", "args": {"ticks": 20}}
{"id": "jarTooltip", "command": "client.tooltip", "args": {"slot": "0"}, "checks": [{"left": "result.lines", "op": "contains", "value": "Dirty"}]}

// Five jars side by side on the floor behind the scene, one of each grade and one of sea water, so
// one picture says whether the tints tell each other apart. The player faces south, so east is on
// the left: left to right the picture has dirty, murky, clean, pure, salty, with the crosshair on
// the clean one for Jade.
{"id": "tintJar0", "command": "server.command", "args": {"command": "setblock 2 200 4 supplementaries:jar"}}
{"id": "tintFill0", "command": "server.command", "args": {"command": "data merge block 2 200 4 {fluid:{id:\"moonlight:water\",count:8,components:{\"thirstwastaken2:water_purity\":0}}}"}}
{"id": "tintJar1", "command": "server.command", "args": {"command": "setblock 1 200 4 supplementaries:jar"}}
{"id": "tintFill1", "command": "server.command", "args": {"command": "data merge block 1 200 4 {fluid:{id:\"moonlight:water\",count:8,components:{\"thirstwastaken2:water_purity\":1}}}"}}
{"id": "tintJar2", "command": "server.command", "args": {"command": "setblock 0 200 4 supplementaries:jar"}}
{"id": "tintFill2", "command": "server.command", "args": {"command": "data merge block 0 200 4 {fluid:{id:\"moonlight:water\",count:8,components:{\"thirstwastaken2:water_purity\":2}}}"}}
{"id": "tintJar3", "command": "server.command", "args": {"command": "setblock -1 200 4 supplementaries:jar"}}
{"id": "tintFill3", "command": "server.command", "args": {"command": "data merge block -1 200 4 {fluid:{id:\"moonlight:water\",count:8,components:{\"thirstwastaken2:water_purity\":3}}}"}}
{"id": "tintJar4", "command": "server.command", "args": {"command": "setblock -2 200 4 supplementaries:jar"}}
{"id": "tintFill4", "command": "server.command", "args": {"command": "data merge block -2 200 4 {fluid:{id:\"moonlight:water\",count:8,components:{\"thirstwastaken2:water_salty\":1b}}}"}}
{"id": "tintView", "command": "server.command", "args": {"command": "tp @p 0.5 200 1.5 0 20"}}
// Long enough for the advancement toasts the script set off earlier to clear the corner.
{"id": "tintWait", "command": "wait", "args": {"ticks": 160}}
{"id": "tints", "command": "client.capture", "args": {"name": "supplementaries-tints"}}

// Jade, with the crosshair on the clean jar of that row.
{"id": "jadeWait", "command": "wait", "args": {"ticks": 40}}
{"id": "jade", "command": "client.capture", "args": {"name": "supplementaries-jade"}}

// Back to somewhere the faucets are visible, and give them the rest of the time they need. Three
// layers at twenty ticks a bottle is sixty; the wait is generous so a busy client cannot make it flaky.
{"id": "watch", "command": "server.command", "args": {"command": "tp @p -5.5 201 4.5 180 20"}}
{"id": "run", "command": "wait", "args": {"ticks": 300}}
{"id": "scene", "command": "client.capture", "args": {"name": "supplementaries-scene"}}
{"id": "dirtyCarried", "command": "server.command", "args": {"command": "execute if block -3 200 0 minecraft:water_cauldron[level=3,purity=1]"}}
{"id": "sourceDrained", "command": "server.command", "args": {"command": "execute if block -2 201 0 minecraft:cauldron"}}
{"id": "worseKept", "command": "server.command", "args": {"command": "execute if block -7 200 0 minecraft:water_cauldron[level=3,purity=1]"}}
{"id": "sampled", "command": "server.command", "args": {"command": "execute if block -11 200 0 minecraft:water_cauldron[level=3,purity=2]"}}
{"id": "potDrained", "command": "server.command", "args": {"command": "execute if block 9 201 0 thirstwastaken2:copper_hanging_pot[level=0]"}}
{"id": "potGaveDirty", "command": "server.command", "args": {"command": "execute if block 8 200 0 minecraft:water_cauldron[level=2,purity=1]"}}
{"id": "potFilled", "command": "server.command", "args": {"command": "execute if block 11 201 0 thirstwastaken2:copper_hanging_pot[level=3,purity=2]"}}
{"id": "potSourceDrained", "command": "server.command", "args": {"command": "execute if block 12 202 0 minecraft:cauldron"}}
{"id": "unforce", "command": "server.command", "args": {"command": "forceload remove all"}}
