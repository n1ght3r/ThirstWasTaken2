{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -16 -8 15 8"}}
{"id": "float", "command": "server.command", "args": {"command": "effect give @p minecraft:slow_falling 600 0 true"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 600 4 true"}}
{"id": "view", "command": "server.command", "args": {"command": "tp @p 0.5 202 4.5 180 20"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -16 200 -8 15 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -16 199 -8 15 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -16 190 -8 15 212 8 minecraft:plains"}}
