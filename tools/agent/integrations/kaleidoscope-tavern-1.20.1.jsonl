{"id": "placedBarrel", "command": "wait", "args": {"ticks": 10}}
{"id": "barrelBuilt", "command": "server.command", "args": {"command": "execute if block 0 202 0 kaleidoscope_tavern:barrel[layer=ceiling,index=4]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

// A Dirty bucket poured into the barrel and drawn back out with a fresh bucket is still Dirty. A fresh
// one, since on Fabric the bucket emptied keeps its components. Without the integration it came back
// plain, which reads as defaultPurity, Clean.
