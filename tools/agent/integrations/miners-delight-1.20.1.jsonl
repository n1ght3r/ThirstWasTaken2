{"id": "id_vegetable_soup_cup", "command": "server.command", "args": {"command": "give @p miners_delight:vegetable_soup_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_onion_soup_cup", "command": "server.command", "args": {"command": "give @p miners_delight:onion_soup_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_mushroom_stew_cup", "command": "server.command", "args": {"command": "give @p miners_delight:mushroom_stew_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_rabbit_stew_cup", "command": "server.command", "args": {"command": "give @p miners_delight:rabbit_stew_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_cave_soup_cup", "command": "server.command", "args": {"command": "give @p miners_delight:cave_soup_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_bat_soup_cup", "command": "server.command", "args": {"command": "give @p miners_delight:bat_soup_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_insect_stew_cup", "command": "server.command", "args": {"command": "give @p miners_delight:insect_stew_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_bone_broth_cup", "command": "server.command", "args": {"command": "give @p miners_delight:bone_broth_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_beetroot_soup_cup", "command": "server.command", "args": {"command": "give @p miners_delight:beetroot_soup_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "clearIds", "command": "server.command", "args": {"command": "clear @p"}}

// A copper cup scoops a swamp and an ocean source as a bucket does. Biomes are set four blocks at a
// time and reading one blends in the cells next to it, so each pool's biome covers every cell around
// its own and a cell of neither lies between the two, as in kaleidoscope-cookery.jsonl.
{"id": "swampBiome", "command": "server.command", "args": {"command": "fillbiome -8 192 -8 3 207 7 minecraft:swamp"}}
{"id": "swampPool", "command": "server.command", "args": {"command": "fill -3 199 -1 -3 199 1 minecraft:water"}}
{"id": "oceanBiome", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 -13 207 7 minecraft:ocean"}}
{"id": "oceanPool", "command": "server.command", "args": {"command": "fill -19 199 -1 -19 199 1 minecraft:water"}}
{"id": "clearS", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "cupS", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:copper_cup"}}
{"id": "standS", "command": "server.command", "args": {"command": "tp @p -2.5 200 -2.5 0 45"}}
{"id": "settleS", "command": "wait", "args": {"ticks": 20}}
{"id": "scoopS", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "scoopedS", "command": "wait", "args": {"ticks": 10}}
{"id": "swampItem", "command": "server.command", "args": {"command": "data get entity @p SelectedItem"}}
{"id": "swampDirty", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"miners_delight:water_cup\",tag:{thirstwastaken2:{purity:0}}}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "clearO", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "cupO", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:copper_cup"}}
{"id": "standO", "command": "server.command", "args": {"command": "tp @p -18.5 200 -2.5 0 45"}}
{"id": "settleO", "command": "wait", "args": {"ticks": 20}}
{"id": "scoopO", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "scoopedO", "command": "wait", "args": {"ticks": 10}}
{"id": "oceanItem", "command": "server.command", "args": {"command": "data get entity @p SelectedItem"}}
{"id": "oceanSalty", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"miners_delight:water_cup\",tag:{thirstwastaken2:{salty:1b}}}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "poolsGone", "command": "server.command", "args": {"command": "fill -24 199 -8 8 199 8 minecraft:stone"}}
{"id": "plainsBack", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 8 207 7 minecraft:plains"}}

// A salty water cup poured into an empty cauldron leaves a cauldron of sea water (purity=5), not the
// Clean water an unset cauldron reads as. The player looks at the cauldron's body at pitch 30; at 45
// the ray passes between its legs to the floor.
{"id": "emptyCauldron", "command": "server.command", "args": {"command": "setblock 0 200 2 minecraft:cauldron"}}
{"id": "pourClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "pourGive", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:water_cup{thirstwastaken2:{salty:1b}}"}}
{"id": "pourStand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "pourSettle", "command": "wait", "args": {"ticks": 10}}
{"id": "pourUse", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pourUsed", "command": "wait", "args": {"ticks": 10}}
{"id": "pourBlock", "command": "server.command", "args": {"command": "data get block 0 200 2"}}
{"id": "pourSalty", "command": "server.command", "args": {"command": "execute if block 0 200 2 minecraft:water_cauldron[level=3,purity=5]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pourCupBack", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"miners_delight:copper_cup\"}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

// A copper cup drawn from a full Dirty cauldron comes out Dirty, and the cauldron is emptied.
{"id": "dirtyCauldron", "command": "server.command", "args": {"command": "setblock 0 200 2 minecraft:water_cauldron[level=3,purity=1]"}}
{"id": "drawClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drawGive", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:copper_cup"}}
{"id": "drawStand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "drawSettle", "command": "wait", "args": {"ticks": 10}}
{"id": "drawUse", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "drawUsed", "command": "wait", "args": {"ticks": 10}}
{"id": "drawItem", "command": "server.command", "args": {"command": "data get entity @p SelectedItem"}}
{"id": "drawDirty", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"miners_delight:water_cup\",tag:{thirstwastaken2:{purity:0}}}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "drawEmptied", "command": "server.command", "args": {"command": "execute if block 0 200 2 minecraft:cauldron"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

// A Dirty water cup on a full Pure cauldron is not poured into it: Miner's Delight has no interaction
// for it there, and the cup places its water in the world beside the cauldron instead, handing back
// an empty cup. The cauldron stays Pure. It used to take the cup's grade with nothing poured.
{"id": "fullCauldron", "command": "server.command", "args": {"command": "setblock 0 200 2 minecraft:water_cauldron[level=3,purity=4]"}}
{"id": "fullClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "fullGive", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:water_cup{thirstwastaken2:{purity:0,salty:0b}}"}}
{"id": "fullStand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "fullSettle", "command": "wait", "args": {"ticks": 10}}
{"id": "fullUse", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "fullUsed", "command": "wait", "args": {"ticks": 10}}
{"id": "fullBlock", "command": "server.command", "args": {"command": "data get block 0 200 2"}}
{"id": "fullStaysPure", "command": "server.command", "args": {"command": "execute if block 0 200 2 minecraft:water_cauldron[level=3,purity=4]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "fullCupEmptied", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"miners_delight:copper_cup\"}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "fullWaterGone", "command": "server.command", "args": {"command": "fill -1 200 1 1 202 3 minecraft:air replace minecraft:water"}}
{"id": "cauldronGone", "command": "server.command", "args": {"command": "setblock 0 200 2 minecraft:air"}}

// An unstamped water cup's tooltip says Clean, defaultPurity, with no droplet rows: it is a
// container, like the water bucket, not a drink. Read by hand.
{"id": "plainClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "plainGive", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:water_cup"}}
{"id": "plainSettle", "command": "wait", "args": {"ticks": 10}}
{"id": "plainTooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}

// Drinking: the milk cup restores 6 and a beef stew cup 2, from thirst 4 and quenched 0.
{"id": "drink_milk_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_milk_hunger", "command": "server.command", "args": {"command": "effect give @p minecraft:hunger 2 255 true"}}
{"id": "drink_milk_hungry", "command": "wait", "args": {"ticks": 60}}
{"id": "drink_milk_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink_milk_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:milk_cup"}}
{"id": "drink_milk_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_milk_tooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}
{"id": "drink_milk_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
{"id": "drink_milk_done", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_milk_state", "command": "client.state", "expect": {"result.thirst": 10}}
{"id": "drink_stew_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_stew_hunger", "command": "server.command", "args": {"command": "effect give @p minecraft:hunger 2 255 true"}}
{"id": "drink_stew_hungry", "command": "wait", "args": {"ticks": 60}}
{"id": "drink_stew_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink_stew_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with miners_delight:beef_stew_cup"}}
{"id": "drink_stew_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_stew_tooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}
{"id": "drink_stew_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
{"id": "drink_stew_done", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_stew_state", "command": "client.state", "expect": {"result.thirst": 6}}

{"id": "done", "command": "client.state"}
