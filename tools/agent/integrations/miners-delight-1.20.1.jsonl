// miners-delight.jsonl for Minecraft 1.20.1 on Forge, where water on an item is its NBT tag and the
// mod is miners_delight rather than minersdelight: the same cases in the same order, with the
// 1.20.1-1.4.5-backport build. The 1.20.1 worlds new_world.py makes allow no cheats, which
// server.command does not need.
//     python tools/agent/new_world.py 1.20.1-forge MinersAgent
//     ./gradlew ":1.20.1-forge:runClient" -Pagent=tools/agent/integrations/miners-delight-1.20.1.jsonl -Pquickplay=MinersAgent
//     python tools/agent/drive.py run/1.20.1-forge/agent/client tools/agent/integrations/miners-delight-1.20.1.jsonl --verify --max-age 15
//
// The rest of the header of miners-delight.jsonl holds here.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -24 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 600 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 60"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -24 200 -8 8 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -24 199 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 8 207 7 minecraft:plains"}}

// Every id ThirstConfig lists for the mod exists, and the two cups: /give refuses an unknown item.
{"id": "id_water_cup", "command": "server.command", "args": {"command": "give @p miners_delight:water_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_copper_cup", "command": "server.command", "args": {"command": "give @p miners_delight:copper_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_milk_cup", "command": "server.command", "args": {"command": "give @p miners_delight:milk_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_cave_soup", "command": "server.command", "args": {"command": "give @p miners_delight:cave_soup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
