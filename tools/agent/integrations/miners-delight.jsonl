// Miner's Delight in a real client, step 6 of its integration plan: that every id ThirstConfig lists
// for the mod exists, that a copper cup scooping a swamp or ocean source is stamped with that
// water's grade (CopperCupItemMixin), that a salty water cup poured into an empty cauldron leaves a
// cauldron of sea water rather than Clean water, that a copper cup drawn from a Dirty cauldron comes
// out Dirty, that a water cup on a full cauldron changes nothing, that both cups pour into and draw
// from a hanging pot and a distiller a bucket at a time, and that the milk cup and a soup
// cup restore their values. Runs on 1.21.1-neoforge;
// miners-delight-1.20.1.jsonl is the Forge 1.20.1 copy. Run it unattended in a singleplayer world:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/miners-delight.jsonl -Pquickplay=MinersAgent
// MinersAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.21.1-neoforge MinersAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/1.21.1-neoforge/agent/client tools/agent/integrations/miners-delight.jsonl --verify --max-age 15
//
// Create's Spout and Item Drain on a copper cup are in miners-delight-create-1.20.1.jsonl.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -24 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 600 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 60"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -24 200 -8 8 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -24 199 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -24 192 -8 8 207 7 minecraft:plains"}}

