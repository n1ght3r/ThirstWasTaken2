// The distiller takes a cup as it takes a bucket: a Dirty water cup pours its three servings into the
// boiler and hands back the copper cup, and that cup draws three from the basin as a Pure water cup.
{"id": "distTub", "command": "server.command", "args": {"command": "setblock -1 200 2 thirstwastaken2:copper_distiller[facing=north,part=tub,piped=true,cooled=true]"}}
{"id": "distBoiler", "command": "server.command", "args": {"command": "setblock 0 200 2 thirstwastaken2:copper_distiller[facing=north,part=boiler,piped=true]"}}
{"id": "distPourClear", "command": "server.command", "args": {"command": "clear @p"}}
