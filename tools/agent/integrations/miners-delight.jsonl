{"id": "drink_stew_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minersdelight:beef_stew_cup"}}
{"id": "drink_stew_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_stew_tooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}
