{"id": "potPoured", "command": "server.command", "args": {"command": "execute if block 0 200 2 thirstwastaken2:copper_hanging_pot[level=3,purity=1]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "potPourCupBack", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minersdelight:copper_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
