{"id": "potDrawEmptied", "command": "server.command", "args": {"command": "execute if block 0 200 2 thirstwastaken2:copper_hanging_pot[level=0]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
