{"id": "distPoured", "command": "server.command", "args": {"command": "execute if data block 0 200 2 {boiler: 3}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "distPourCupBack", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minersdelight:copper_cup"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "distBasin", "command": "server.command", "args": {"command": "data merge block 0 200 2 {boiler: 0, basin: 3}"}}
{"id": "distDrawStand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "distDrawSettle", "command": "wait", "args": {"ticks": 10}}
{"id": "distDrawUse", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
