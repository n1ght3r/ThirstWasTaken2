// The Sink, on 0 200 2. Left alone it fills itself, a bottle every three seconds; what is drawn is Murky.
{"id": "sink", "command": "server.command", "args": {"command": "setblock 0 200 2 hearthandharvest:basin"}}
{"id": "sink_fills", "command": "wait", "args": {"ticks": 200}}
{"id": "sink_draw_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:glass_bottle"}}
{"id": "sink_draw_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "sink_draw_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "sink_draw_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
