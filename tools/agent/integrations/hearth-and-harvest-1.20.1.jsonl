// hearth-and-harvest.jsonl for Hearth and Harvest's 1.20.1 build on Forge, the early mod: every id
// ThirstConfig lists that this build has exists; the Cooking Pot boils a Murky bottle Pure and a sea
// water bottle into two salt, and a Pure bottle, which Hearth and Harvest's own recipe boiled into salt,
// stays put (src/main/hearthandharvestforge); a placed Jug keeps the grade of a bucket poured in; and a
// juice restores 8. A stack's water is its NBT tag
// here. Runs on 1.20.1-forge. Run it unattended:
//     ./gradlew ":1.20.1-forge:runClient" -Pagent=tools/agent/integrations/hearth-and-harvest-1.20.1.jsonl -Pquickplay=HearthAgent -PwithoutOptional=cold-sweat
// HearthAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.20.1-forge HearthAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/1.20.1-forge/agent/client tools/agent/integrations/hearth-and-harvest-1.20.1.jsonl --verify --max-age 15

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "view", "command": "server.command", "args": {"command": "tp @p 0.5 200 -3.5 0 25"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -6 200 -6 6 206 6 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -6 199 -6 6 199 6 minecraft:stone"}}
{"id": "stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 -3.5 0 25"}}

