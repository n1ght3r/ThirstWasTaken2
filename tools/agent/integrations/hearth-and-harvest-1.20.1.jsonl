// Two Kegs on -3 200 4 and -5 200 4, each with mead's honey bottle and sugar over a bottle's worth of
// water, Murky in one and sea water in the other. The Murky keg starts fermenting; the salty one never
// does. (From 1.4.1 the Cask only ages finished drinks.)
{"id": "kegPlain", "command": "server.command", "args": {"command": "setblock -3 200 4 hearthandharvest:keg"}}
{"id": "kegSalty", "command": "server.command", "args": {"command": "setblock -5 200 4 hearthandharvest:keg"}}
{"id": "kegsFormed", "command": "wait", "args": {"ticks": 10}}
{"id": "kegPlainFill", "command": "server.command", "args": {"command": "data merge block -3 200 4 {InputTank:{FluidName:\"minecraft:water\",Amount:250,Tag:{thirstwastaken2:{purity:1,salty:0b}}},Inventory:{Size:6,Items:[{Slot:0,id:\"minecraft:honey_bottle\",Count:1b},{Slot:1,id:\"minecraft:sugar\",Count:1b}]}}"}}
{"id": "kegSaltyFill", "command": "server.command", "args": {"command": "data merge block -5 200 4 {InputTank:{FluidName:\"minecraft:water\",Amount:250,Tag:{thirstwastaken2:{salty:1b}}},Inventory:{Size:6,Items:[{Slot:0,id:\"minecraft:honey_bottle\",Count:1b},{Slot:1,id:\"minecraft:sugar\",Count:1b}]}}"}}
{"id": "kegFerment", "command": "wait", "args": {"ticks": 60}}
{"id": "kegPlainAfter", "command": "server.command", "args": {"command": "data get block -3 200 4"}}
{"id": "kegPlainFermenting", "command": "server.command", "args": {"command": "execute if data block -3 200 4 {FermentTime:0}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test failed"}]}
{"id": "kegSaltyAfter", "command": "server.command", "args": {"command": "data get block -5 200 4"}}
{"id": "kegSaltyIdle", "command": "server.command", "args": {"command": "execute if data block -5 200 4 {FermentTime:0}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "kegsGone", "command": "server.command", "args": {"command": "fill -5 200 4 -3 200 4 minecraft:air"}}

// Three Cooking Pots on lit campfires: a Murky bottle boils Clean, by our recipe and not into salt; a sea
// water bottle boils into two salt, which Hearth and Harvest's exact-NBT recipe alone would never match;
// and a Pure bottle stays put.
{"id": "murkyFire", "command": "server.command", "args": {"command": "setblock 0 200 -3 minecraft:campfire"}}
{"id": "murkyPot", "command": "server.command", "args": {"command": "setblock 0 201 -3 farmersdelight:cooking_pot"}}
{"id": "murky", "command": "server.command", "args": {"command": "data merge block 0 201 -3 {Inventory:{Size:9,Items:[{Slot:0,id:\"minecraft:potion\",Count:1b,tag:{Potion:\"minecraft:water\",thirstwastaken2:{purity:1,salty:0b}}}]}}"}}
{"id": "saltyFire", "command": "server.command", "args": {"command": "setblock 2 200 -3 minecraft:campfire"}}
{"id": "saltyPot", "command": "server.command", "args": {"command": "setblock 2 201 -3 farmersdelight:cooking_pot"}}
{"id": "salty", "command": "server.command", "args": {"command": "data merge block 2 201 -3 {Inventory:{Size:9,Items:[{Slot:0,id:\"minecraft:potion\",Count:1b,tag:{Potion:\"minecraft:water\",thirstwastaken2:{salty:1b}}}]}}"}}
{"id": "pureFire", "command": "server.command", "args": {"command": "setblock 4 200 -3 minecraft:campfire"}}
{"id": "purePot", "command": "server.command", "args": {"command": "setblock 4 201 -3 farmersdelight:cooking_pot"}}
{"id": "pure", "command": "server.command", "args": {"command": "data merge block 4 201 -3 {Inventory:{Size:9,Items:[{Slot:0,id:\"minecraft:potion\",Count:1b,tag:{Potion:\"minecraft:water\",thirstwastaken2:{purity:3,salty:0b}}}]}}"}}
{"id": "boil", "command": "wait", "args": {"ticks": 360}}
{"id": "potAfter", "command": "server.command", "args": {"command": "data get block 0 201 -3 Inventory"}}
{"id": "bottleClean", "command": "server.command", "args": {"command": "execute if data block 0 201 -3 Inventory.Items[{Slot:8,id:\"minecraft:potion\",tag:{thirstwastaken2:{purity:2}}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "saltAfter", "command": "server.command", "args": {"command": "data get block 2 201 -3 Inventory"}}
{"id": "saltMade", "command": "server.command", "args": {"command": "execute if data block 2 201 -3 Inventory.Items[{Slot:8,id:\"hearthandharvest:salt\",Count:2b}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pureAfter", "command": "server.command", "args": {"command": "data get block 4 201 -3 Inventory"}}
{"id": "pureStays", "command": "server.command", "args": {"command": "execute if data block 4 201 -3 Inventory.Items[{Slot:0,tag:{thirstwastaken2:{purity:3}}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "potsGone", "command": "server.command", "args": {"command": "fill 0 200 -3 4 201 -3 minecraft:air"}}

// Drinking from thirst 4, quenched 0, looking up so nothing is placed: a juice restores 6, a glass of
// wine 3. A juice may be a food here, so the player is made hungry first.
{"id": "drink_cherry_juice_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_cherry_juice_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 -30"}}
