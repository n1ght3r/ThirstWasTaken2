{"id": "stomp_settle", "command": "wait", "args": {"ticks": 20}}
{"id": "stomp_put", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "stomp_put_done", "command": "wait", "args": {"ticks": 10}}
