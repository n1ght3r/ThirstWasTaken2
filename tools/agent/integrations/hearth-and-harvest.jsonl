// Hearth and Harvest in a real client, the check of its integration plan
// (docs/dev/integration/cooking/HEARTH-AND-HARVEST-INTEGRATION.md). What it proves: every id ThirstConfig
// lists for the mod exists; the Sink gives Murky water, filled by itself or poured into, and refuses sea
// water; a Trough keeps the grade poured in and refuses a second grade; a Sprinkler keeps a bucket's
// grade; a Jug scooping the sea holds sea water; a wet sponge stomped gives Murky water; a Cask ages
// mead from a plain bottle and not from a salty one; the Cooking Pot boils a Murky bottle Pure and a sea
// water one into salt; and a juice and a wine restore what ThirstConfig says. Runs on 1.21.1-neoforge.
// Run it unattended:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/hearth-and-harvest.jsonl -Pquickplay=HearthAgent -PwithoutOptional=cold-sweat
// HearthAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.21.1-neoforge HearthAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/1.21.1-neoforge/agent/client tools/agent/integrations/hearth-and-harvest.jsonl --verify --max-age 15
//
// Everything happens on a stone floor at y 199. The player stands at 0.5 200 0.5 looking south at pitch
// 30, at the block on 0 200 2. A bottle or bucket used on a tank comes back in the hand when it is the
// only one held.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 30"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 210 8 minecraft:air"}}
{"id": "box", "command": "server.command", "args": {"command": "fill -8 194 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 8 212 8 minecraft:plains"}}

