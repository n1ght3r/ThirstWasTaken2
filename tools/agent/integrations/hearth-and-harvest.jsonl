// Three Cooking Pots on lit campfires: a Murky bottle boils Pure, by our recipe and not into salt; a sea
// water bottle boils into two salt, by the recipe that replaces Hearth and Harvest's; and a Pure bottle,
// which Hearth and Harvest's own recipe would boil into salt, stays put, which shows ours replaced it.
// Expanded Delight, on this client too, refuses sea water in the pot except for a recipe asking for it.
{"id": "potFire", "command": "server.command", "args": {"command": "setblock 0 200 -3 minecraft:campfire"}}
{"id": "pot", "command": "server.command", "args": {"command": "setblock 0 201 -3 farmersdelight:cooking_pot"}}
{"id": "saltFire", "command": "server.command", "args": {"command": "setblock 2 200 -3 minecraft:campfire"}}
{"id": "saltPot", "command": "server.command", "args": {"command": "setblock 2 201 -3 farmersdelight:cooking_pot"}}
{"id": "murky", "command": "server.command", "args": {"command": "data merge block 0 201 -3 {Inventory:{Size:9,Items:[{Slot:0b,id:\"minecraft:potion\",count:1,components:{\"minecraft:potion_contents\":{potion:\"minecraft:water\"},\"thirstwastaken2:water_purity\":1,\"thirstwastaken2:water_salty\":false}}]}}"}}
{"id": "salty", "command": "server.command", "args": {"command": "data merge block 2 201 -3 {Inventory:{Size:9,Items:[{Slot:0b,id:\"minecraft:potion\",count:1,components:{\"minecraft:potion_contents\":{potion:\"minecraft:water\"},\"thirstwastaken2:water_salty\":true}}]}}"}}
{"id": "pureFire", "command": "server.command", "args": {"command": "setblock 4 200 -3 minecraft:campfire"}}
{"id": "purePot", "command": "server.command", "args": {"command": "setblock 4 201 -3 farmersdelight:cooking_pot"}}
{"id": "pure", "command": "server.command", "args": {"command": "data merge block 4 201 -3 {Inventory:{Size:9,Items:[{Slot:0b,id:\"minecraft:potion\",count:1,components:{\"minecraft:potion_contents\":{potion:\"minecraft:water\"},\"thirstwastaken2:water_purity\":3,\"thirstwastaken2:water_salty\":false}}]}}"}}
{"id": "boil", "command": "wait", "args": {"ticks": 360}}
{"id": "potAfter", "command": "server.command", "args": {"command": "data get block 0 201 -3 Inventory"}}
{"id": "bottlePure", "command": "server.command", "args": {"command": "execute if data block 0 201 -3 Inventory.Items[{Slot:8,id:\"minecraft:potion\",components:{\"thirstwastaken2:water_purity\":3}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "saltAfter", "command": "server.command", "args": {"command": "data get block 2 201 -3 Inventory"}}
{"id": "saltMade", "command": "server.command", "args": {"command": "execute if data block 2 201 -3 Inventory.Items[{Slot:8,id:\"hearthandharvest:salt\",count:2}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pureStays", "command": "server.command", "args": {"command": "execute if data block 4 201 -3 Inventory.Items[{Slot:0,components:{\"thirstwastaken2:water_purity\":3}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "potsGone", "command": "server.command", "args": {"command": "fill 0 200 -3 4 201 -3 minecraft:air"}}

// Drinking from thirst 4, quenched 0, looking up so nothing is placed: a juice restores 8, a wine 3.
{"id": "drink_cherry_juice_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_cherry_juice_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 -30"}}
{"id": "drink_cherry_juice_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink_cherry_juice_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with hearthandharvest:cherry_juice"}}
{"id": "drink_cherry_juice_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_cherry_juice_tooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}
{"id": "drink_cherry_juice_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
{"id": "drink_cherry_juice_done", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_cherry_juice_state", "command": "client.state", "expect": {"result.thirst": 12}}
{"id": "drink_red_grape_wine_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_red_grape_wine_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink_red_grape_wine_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with hearthandharvest:red_grape_wine"}}
{"id": "drink_red_grape_wine_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_red_grape_wine_tooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}
{"id": "drink_red_grape_wine_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
{"id": "drink_red_grape_wine_done", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_red_grape_wine_state", "command": "client.state", "expect": {"result.thirst": 7}}
