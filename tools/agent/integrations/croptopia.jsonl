{"id": "clearIds", "command": "server.command", "args": {"command": "clear @p"}}

// One Crafter a case, each facing north into a chest, fired by a redstone block set on top of it.
// The water bottle is glass either side of the bucket with one more glass under it; tea is the
// leaves over the water. A Crafter that makes nothing leaves the chest empty.
{"id": "clean_bottles_crafter", "command": "server.command", "args": {"command": "setblock 0 200 4 minecraft:crafter[orientation=north_up]"}}
{"id": "clean_bottles_chest", "command": "server.command", "args": {"command": "setblock 0 200 3 minecraft:chest[facing=south]"}}
{"id": "clean_bottles_slot3", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.3 with minecraft:glass 1"}}
{"id": "clean_bottles_slot4", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.4 with minecraft:water_bucket[thirstwastaken2:water_purity=2,thirstwastaken2:water_salty=false] 1"}}
{"id": "clean_bottles_slot5", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.5 with minecraft:glass 1"}}
{"id": "clean_bottles_slot7", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.7 with minecraft:glass 1"}}
{"id": "clean_bottles_fire", "command": "server.command", "args": {"command": "setblock 0 201 4 minecraft:redstone_block"}}
{"id": "clean_bottles_wait", "command": "wait", "args": {"ticks": 20}}
{"id": "clean_bottles_result", "command": "server.command", "args": {"command": "execute if items block 0 200 3 container.* croptopia:water_bottle"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
