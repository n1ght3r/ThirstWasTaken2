// Croptopia in a real client: the check of its integration plan
// (docs/dev/integration/cooking/CROPTOPIA-INTEGRATION.md). What it proves: the ids ThirstConfig and the
// recipes below use exist; a fresh water bucket of any grade still crafts sixteen water bottles, and a
// sea water bucket crafts none; tea crafts from Croptopia's water bottle but not from a sea water bucket;
// and a juice, tea, wine, a soup and a cucumber restore what ThirstConfig says.
// Crafting goes through a Crafter, which asks the same recipe matcher a crafting table does, so it needs
// 1.21 or later: it runs on 1.21.1, 26.1.x and 26.2.x, either loader, with Croptopia's two runClientMod
// lines uncommented. Run it unattended:
//     ./gradlew ":1.21.1:runClient" -Pagent=tools/agent/integrations/croptopia.jsonl -Pquickplay=CroptopiaAgent
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/croptopia.jsonl -Pquickplay=CroptopiaAgent -PwithoutOptional=cold-sweat
// CroptopiaAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> CroptopiaAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/integrations/croptopia.jsonl --verify --max-age 15
//
// Everything happens on a stone floor at y 199, biome plains. The player stands at 0.5 200 0.5.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 30"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 210 8 minecraft:air"}}
{"id": "box", "command": "server.command", "args": {"command": "fill -8 194 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 8 212 8 minecraft:plains"}}

// The ids used below: /give refuses an unknown item.
{"id": "id_water_bottle", "command": "server.command", "args": {"command": "give @p croptopia:water_bottle"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
