{"id": "drink_orange_juice_hunger", "command": "server.command", "args": {"command": "effect give @p minecraft:hunger 6 255 true"}}
{"id": "drink_orange_juice_hungry", "command": "wait", "args": {"ticks": 140}}
{"id": "drink_orange_juice_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
