// No Man's Land in a real client: the check of its integration plan
// (docs/dev/integration/world/NO-MANS-LAND-INTEGRATION.md). What it proves: every id ThirstConfig lists
// for the mod exists; its drinks restore what ThirstConfig says; water in its Bog, Bayou, Dark Swamp and
// Blackwater River grades Dirty like a vanilla swamp's, where plains water is Murky; the sea at its Mud
// Beach is salty; and a milk cauldron gives four sips of a quarter of a milk bucket each.
// Runs on 1.21.1-neoforge only, with the runClientMod line for No Man's Land uncommented in
// build.neoforge.gradle.kts. Run it unattended:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/no-mans-land.jsonl -Pquickplay=NoMansLandAgent -PwithoutOptional=cold-sweat
// NoMansLandAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.21.1-neoforge NoMansLandAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/1.21.1-neoforge/agent/client tools/agent/integrations/no-mans-land.jsonl --verify --max-age 15
//
// Everything happens on a stone floor at y 199. The player stands at 0.5 200 0.5. At y 199 a still
// source scores its biome's base less 5: a swamp's 85 is Dirty, plains' 55 Murky.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 30"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 210 8 minecraft:air"}}
{"id": "box", "command": "server.command", "args": {"command": "fill -8 194 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 8 212 8 minecraft:plains"}}

// Every id ThirstConfig lists, and the milk cauldron: /give and /setblock refuse an unknown id. The juice,
// the pesto and the witch stew need Farmer's Delight, which runClient has.
{"id": "id_pear_juice", "command": "server.command", "args": {"command": "give @p nomansland:pear_juice"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
