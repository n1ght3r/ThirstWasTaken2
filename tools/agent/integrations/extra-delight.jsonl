// The Tap, on 0 200 2: a glass bottle and an empty bucket both draw Murky water.
{"id": "tapClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "tap", "command": "server.command", "args": {"command": "setblock 0 200 2 extradelight:tap"}}
{"id": "tap_bottle_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:glass_bottle"}}
{"id": "tap_bottle_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "tap_bottle_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "tap_bottle_used", "command": "wait", "args": {"ticks": 10}}
{"id": "tap_bottle_murky", "command": "server.command", "args": {"command": "clear @p minecraft:potion[thirstwastaken2:water_purity=1] 0"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Found"}]}
{"id": "tap_bucket_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:bucket"}}
{"id": "tap_bucket_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "tap_bucket_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "tap_bucket_used", "command": "wait", "args": {"ticks": 10}}
{"id": "tap_bucket_murky", "command": "server.command", "args": {"command": "execute if items entity @p weapon.mainhand minecraft:water_bucket[thirstwastaken2:water_purity=1]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "tapGone", "command": "server.command", "args": {"command": "setblock 0 200 2 minecraft:air"}}
{"id": "tapDry", "command": "server.command", "args": {"command": "fill -8 200 -8 8 203 8 minecraft:air replace minecraft:water"}}

