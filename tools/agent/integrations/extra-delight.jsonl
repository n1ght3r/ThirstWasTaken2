// Extra Delight in a real client, the check of its integration plan
// (docs/dev/integration/cooking/EXTRA-DELIGHT-INTEGRATION.md). What it proves: every id ThirstConfig lists
// for the mod exists; the Tap and the Sink give Murky water, by bottle and by bucket; a Jar keeps the grade
// of a bottle and of a bucket and refuses a second grade; a Keg keeps sea water salty; the Evaporator
// works on sea water and not on fresh; the Mixing Bowl stirs fresh water and not sea water; a Funnel grades
// the source it takes up; and a drink restores what ThirstConfig says. Runs on 1.21.1-neoforge.
// Run it unattended:
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/extra-delight.jsonl -Pquickplay=ExtraDelightAgent -PwithoutOptional=cold-sweat
// ExtraDelightAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py 1.21.1-neoforge ExtraDelightAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/1.21.1-neoforge/agent/client tools/agent/integrations/extra-delight.jsonl --verify --max-age 15
//
// Everything happens on a stone floor at y 199. The player stands at 0.5 200 0.5 looking south at pitch
// 30, at the block on 0 200 2. A bottle or bucket used on a block comes back in the hand when it is the
// only one held.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "difficulty", "command": "server.command", "args": {"command": "difficulty normal"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 30"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 210 8 minecraft:air"}}
{"id": "box", "command": "server.command", "args": {"command": "fill -8 194 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 8 212 8 minecraft:plains"}}
{"id": "stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}

