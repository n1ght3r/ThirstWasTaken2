{"id": "boilerAfter", "command": "server.command", "args": {"command": "data get block 10 200 -5 Items"}}

// ---- The Hearth ----------------------------------------------------------------------------------
// Cold Sweat takes no water as Hearth fuel, graded or not, so the hopper keeps the water bucket.
{"id": "hearthWater", "command": "server.command", "args": {"command": "setblock 14 200 -5 cold_sweat:hearth_bottom"}}
{"id": "hopperWater", "command": "server.command", "args": {"command": "setblock 13 200 -5 minecraft:hopper[facing=east]{Items:[{Slot:0b,id:\"minecraft:water_bucket\",Count:1b,tag:{thirstwastaken2:{purity:0,salty:0b}}}]}"}}
{"id": "hearthLava", "command": "server.command", "args": {"command": "setblock 14 200 -2 cold_sweat:hearth_bottom"}}
{"id": "hopperLava", "command": "server.command", "args": {"command": "setblock 13 200 -2 minecraft:hopper[facing=east]{Items:[{Slot:0b,id:\"minecraft:lava_bucket\",Count:1b}]}"}}
{"id": "hearthsFed", "command": "wait", "args": {"ticks": 40}}
{"id": "waterNotFuel", "command": "server.command", "args": {"command": "execute if data block 13 200 -5 Items[{Slot:0b,id:\"minecraft:water_bucket\"}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
// Unlike 2.4.3.1 on NeoForge, the Hearth of 2.4.3.2 on Forge kept the lava bucket in this setup too
// (2026-10-01), so the lava hopper is only recorded. What matters is that water is not fuel.
{"id": "lavaHopper", "command": "server.command", "args": {"command": "data get block 13 200 -2 Items"}}

