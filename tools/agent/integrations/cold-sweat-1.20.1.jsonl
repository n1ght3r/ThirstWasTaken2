{"id": "fillSource", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "filledSource", "command": "wait", "args": {"ticks": 10}}
{"id": "sourceGraded", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"cold_sweat:filled_waterskin\",tag:{thirstwastaken2:{salty:0b}}}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "sourceHasGrade", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem.tag.thirstwastaken2.purity"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "sourceSkin", "command": "server.command", "args": {"command": "data get entity @p SelectedItem.tag"}}
{"id": "sourceTooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}

{"id": "sourceSea", "command": "server.command", "args": {"command": "setblock 20 199 3 minecraft:water"}}
