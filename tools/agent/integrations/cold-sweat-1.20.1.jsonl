{"id": "boiledSea", "command": "server.command", "args": {"command": "execute if data block 10 200 -5 Items[{id:\"minecraft:water_bucket\",tag:{thirstwastaken2:{salty:1b}}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
