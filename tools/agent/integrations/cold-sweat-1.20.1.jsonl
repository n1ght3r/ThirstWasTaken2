// cold-sweat.jsonl for Minecraft 1.20.1 on Forge, where water on an item is its NBT tag: the same cases
// in the same order, with Cold Sweat 2.4.3.2. Uncomment Cold Sweat's runClientMod line in
// build.forge.gradle.kts first; it is off by default. The 1.20.1 worlds new_world.py makes allow no
// cheats, which server.command does not need.
//     python tools/agent/new_world.py 1.20.1-forge ColdSweatAgent
//     ./gradlew ":1.20.1-forge:runClient" -Pagent=tools/agent/integrations/cold-sweat-1.20.1.jsonl -Pquickplay=ColdSweatAgent
//     python tools/agent/drive.py run/1.20.1-forge/agent/client tools/agent/integrations/cold-sweat-1.20.1.jsonl --verify --max-age 15
//
// The rest of the header of cold-sweat.jsonl holds here: the climate cases are read by hand, against
// about 0.93, 0.59 and 1.2 from the biome alone.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "arrived", "command": "client.state"}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}

{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 88 8"}}
{"id": "float", "command": "server.command", "args": {"command": "effect give @p minecraft:slow_falling 900 0 true"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 900 4 true"}}
{"id": "view", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 90"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 88 208 8 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -8 199 -8 88 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 15 215 8 minecraft:plains"}}
{"id": "ocean", "command": "server.command", "args": {"command": "fillbiome 16 190 -8 27 215 8 minecraft:ocean"}}
{"id": "snowy", "command": "server.command", "args": {"command": "fillbiome 32 190 -8 51 215 8 minecraft:snowy_plains"}}
{"id": "desert", "command": "server.command", "args": {"command": "fillbiome 64 190 -8 83 215 8 minecraft:desert"}}
{"id": "notThirsty", "command": "server.command", "args": {"command": "thirst set @p 20 20"}}

// ---- Climate -------------------------------------------------------------------------------------
{"id": "toPlains", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 0"}}
{"id": "settlePlains", "command": "wait", "args": {"ticks": 80}}
{"id": "plainsModifier", "command": "server.thirst.modifier", "args": {"player": "Dev"}}
{"id": "plainsTemp", "command": "server.command", "args": {"command": "temp get @p world"}}
{"id": "toSnowy", "command": "server.command", "args": {"command": "tp @p 40.5 200 0.5 0 0"}}
{"id": "settleSnowy", "command": "wait", "args": {"ticks": 80}}
{"id": "snowyModifier", "command": "server.thirst.modifier", "args": {"player": "Dev"}}
{"id": "snowyTemp", "command": "server.command", "args": {"command": "temp get @p world"}}
{"id": "toDesert", "command": "server.command", "args": {"command": "tp @p 72.5 200 0.5 0 0"}}
{"id": "settleDesert", "command": "wait", "args": {"ticks": 80}}
{"id": "desertModifier", "command": "server.thirst.modifier", "args": {"player": "Dev"}}
{"id": "desertTemp", "command": "server.command", "args": {"command": "temp get @p world"}}
{"id": "night", "command": "server.command", "args": {"command": "time set midnight"}}
{"id": "settleNight", "command": "wait", "args": {"ticks": 80}}
{"id": "desertNightModifier", "command": "server.thirst.modifier", "args": {"player": "Dev"}}
{"id": "desertNightTemp", "command": "server.command", "args": {"command": "temp get @p world"}}
{"id": "dayAgain", "command": "server.command", "args": {"command": "time set noon"}}

// ---- Filling the waterskin -----------------------------------------------------------------------
{"id": "sourcePlains", "command": "server.command", "args": {"command": "setblock 2 199 3 minecraft:water"}}
{"id": "atSource", "command": "server.command", "args": {"command": "tp @p 2.5 200 2.5 0 60"}}
