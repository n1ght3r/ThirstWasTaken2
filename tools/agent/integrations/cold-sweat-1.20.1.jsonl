{"id": "regenQuenched", "command": "server.command", "args": {"command": "thirst set @p 20 20"}}
{"id": "regenWaitQuenched", "command": "wait", "args": {"ticks": 200}}
{"id": "regenQuenchedState", "command": "client.state", "checks": [{"left": "result.health", "op": "gt", "value": 12}]}
{"id": "regenSafe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 600 4 true"}}

// ---- Hot drinks warm -----------------------------------------------------------------------------
// Read by hand: base after is 10 above before, through this integration's food data and its
// forge:conditions.
{"id": "cocoaThirsty", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "cocoa", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with farmersdelight:hot_cocoa"}}
{"id": "baseBefore", "command": "server.command", "args": {"command": "temp get @p base"}}
{"id": "settleCocoa", "command": "wait", "args": {"ticks": 20}}
{"id": "drinkCocoa", "command": "client.hold", "args": {"keys": ["use"], "ticks": 50}}
{"id": "drankCocoa", "command": "wait", "args": {"ticks": 10}}
{"id": "baseAfter", "command": "server.command", "args": {"command": "temp get @p base"}}
{"id": "cocoaQuenched", "command": "client.state", "checks": [{"left": "result.thirst", "op": "gt", "value": 4}]}

{"id": "hudSkin", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with cold_sweat:filled_waterskin{thirstwastaken2:{purity:2,salty:0b}}"}}
{"id": "settleHud", "command": "wait", "args": {"ticks": 20}}
{"id": "hud", "command": "client.capture", "args": {"name": "cold-sweat-hud"}}
