{"id": "emptySkinSea", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with cold_sweat:waterskin"}}
{"id": "settleSea", "command": "wait", "args": {"ticks": 20}}
{"id": "fillSea", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "filledSea", "command": "wait", "args": {"ticks": 10}}
{"id": "seaSalty", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"cold_sweat:filled_waterskin\",tag:{thirstwastaken2:{salty:1b}}}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "seaTooltip", "command": "client.tooltip", "args": {"slot": "mainhand"}}

{"id": "cauldronDirty", "command": "server.command", "args": {"command": "setblock 6 200 3 minecraft:water_cauldron[level=3,purity=1]"}}
{"id": "atCauldron", "command": "server.command", "args": {"command": "tp @p 6.5 200 1.5 0 25"}}
{"id": "emptySkinCauldron", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with cold_sweat:waterskin"}}
{"id": "settleCauldron", "command": "wait", "args": {"ticks": 20}}
{"id": "fillCauldron", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "filledCauldron", "command": "wait", "args": {"ticks": 10}}
{"id": "cauldronSkinDirty", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"cold_sweat:filled_waterskin\",tag:{thirstwastaken2:{purity:0}}}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "cauldronLowered", "command": "server.command", "args": {"command": "execute if block 6 200 3 minecraft:water_cauldron[level=2,purity=1]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

{"id": "cauldronPure", "command": "server.command", "args": {"command": "setblock 6 200 3 minecraft:water_cauldron[level=1,purity=4]"}}
{"id": "emptySkinLast", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with cold_sweat:waterskin"}}
{"id": "settleLast", "command": "wait", "args": {"ticks": 20}}
{"id": "fillLast", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "filledLast", "command": "wait", "args": {"ticks": 10}}
{"id": "lastSkinPure", "command": "server.command", "args": {"command": "execute if data entity @p SelectedItem{id:\"cold_sweat:filled_waterskin\",tag:{thirstwastaken2:{purity:3}}}"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "cauldronEmptied", "command": "server.command", "args": {"command": "execute if block 6 200 3 minecraft:cauldron"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

// ---- Pouring into a cauldron ---------------------------------------------------------------------
// The skin left behind is empty and carries no thirstwastaken2 compound at all, so it stacks with a new one.
{"id": "dirtySkin", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with cold_sweat:filled_waterskin{thirstwastaken2:{purity:0,salty:0b}}"}}
{"id": "settlePour", "command": "wait", "args": {"ticks": 20}}
{"id": "pourDirty", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pouredDirty", "command": "wait", "args": {"ticks": 10}}
{"id": "cauldronStoredDirty", "command": "server.command", "args": {"command": "execute if block 6 200 3 minecraft:water_cauldron[level=1,purity=1]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pourLeftSkin", "command": "server.command", "args": {"command": "execute if data entity @p Inventory[{id:\"cold_sweat:waterskin\"}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pourLeftPlainSkin", "command": "server.command", "args": {"command": "execute unless data entity @p Inventory[{id:\"cold_sweat:waterskin\",tag:{thirstwastaken2:{}}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pureSkin", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with cold_sweat:filled_waterskin{thirstwastaken2:{purity:3,salty:0b}}"}}
{"id": "settlePourPure", "command": "wait", "args": {"ticks": 20}}
{"id": "pourPure", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "pouredPure", "command": "wait", "args": {"ticks": 10}}
{"id": "cauldronKeptWorse", "command": "server.command", "args": {"command": "execute if block 6 200 3 minecraft:water_cauldron[level=2,purity=1]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

