// A placed Jug, filled with three green teas by hand, drunk with an empty hand from thirst 4: three
// teas are 18, 27, so thirst lands on the cap of 20 and quenched on its own cap.
{"id": "jug_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "jug_place", "command": "server.command", "args": {"command": "setblock 0 200 2 herbalbrews:jug"}}
{"id": "jug_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 30"}}
{"id": "jug_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with herbalbrews:green_tea 3"}}
{"id": "jug_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "jug_fill_use0", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "jug_fill_used0", "command": "wait", "args": {"ticks": 10}}
