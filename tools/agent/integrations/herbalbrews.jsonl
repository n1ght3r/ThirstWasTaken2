// Tea Kettles on HerbalBrews stoves, filled through their slots: dried green tea (1), a glass bottle
// (2), water (6), blaze powder (7) to lift the heat from 30 past the recipe's 40.
{"id": "kettle_plain_stove", "command": "server.command", "args": {"command": "setblock 0 200 4 herbalbrews:stove"}}
{"id": "kettle_plain_kettle", "command": "server.command", "args": {"command": "setblock 0 201 4 herbalbrews:tea_kettle"}}
{"id": "kettle_plain_leaves", "command": "server.command", "args": {"command": "item replace block 0 201 4 container.1 with herbalbrews:dried_green_tea"}}
{"id": "kettle_plain_bottle", "command": "server.command", "args": {"command": "item replace block 0 201 4 container.2 with minecraft:glass_bottle"}}
{"id": "kettle_plain_heat", "command": "server.command", "args": {"command": "item replace block 0 201 4 container.7 with minecraft:blaze_powder"}}
{"id": "kettle_plain_water", "command": "server.command", "args": {"command": "item replace block 0 201 4 container.6 with minecraft:water_bucket"}}
{"id": "kettle_salty_stove", "command": "server.command", "args": {"command": "setblock 2 200 4 herbalbrews:stove"}}
{"id": "kettle_salty_kettle", "command": "server.command", "args": {"command": "setblock 2 201 4 herbalbrews:tea_kettle"}}
{"id": "kettle_salty_leaves", "command": "server.command", "args": {"command": "item replace block 2 201 4 container.1 with herbalbrews:dried_green_tea"}}
{"id": "kettle_salty_bottle", "command": "server.command", "args": {"command": "item replace block 2 201 4 container.2 with minecraft:glass_bottle"}}
{"id": "kettle_salty_heat", "command": "server.command", "args": {"command": "item replace block 2 201 4 container.7 with minecraft:blaze_powder"}}
{"id": "kettle_salty_water", "command": "server.command", "args": {"command": "item replace block 2 201 4 container.6 with minecraft:water_bucket[thirstwastaken2:water_salty=true]"}}
{"id": "brew", "command": "wait", "args": {"ticks": 200}}
{"id": "kettle_plain_tea", "command": "server.command", "args": {"command": "execute if items block 0 201 4 container.0 herbalbrews:green_tea"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "kettle_plain_bucket_back", "command": "server.command", "args": {"command": "execute if items block 0 201 4 container.6 minecraft:bucket"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "kettle_salty_tea", "command": "server.command", "args": {"command": "execute if items block 2 201 4 container.0 herbalbrews:green_tea"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test failed"}]}
{"id": "kettle_salty_kept", "command": "server.command", "args": {"command": "execute if items block 2 201 4 container.6 minecraft:water_bucket[thirstwastaken2:water_salty=true]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "kettle_clear", "command": "server.command", "args": {"command": "fill -8 200 -8 8 202 8 minecraft:air"}}

// Drinking from thirst 4, quenched 0, looking up so nothing is placed: a tea is 6, 9, coffee 5, 8.
{"id": "drink_green_tea_clear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "drink_green_tea_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 -30"}}
{"id": "drink_green_tea_hunger", "command": "server.command", "args": {"command": "effect give @p minecraft:hunger 2 255 true"}}
{"id": "drink_green_tea_hungry", "command": "wait", "args": {"ticks": 60}}
{"id": "drink_green_tea_set", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "drink_green_tea_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with herbalbrews:green_tea"}}
{"id": "drink_green_tea_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_green_tea_use", "command": "client.hold", "args": {"keys": ["use"], "ticks": 45}}
{"id": "drink_green_tea_done", "command": "wait", "args": {"ticks": 10}}
{"id": "drink_green_tea_state", "command": "client.state", "expect": {"result.thirst": 10, "result.quenched": 9}}
