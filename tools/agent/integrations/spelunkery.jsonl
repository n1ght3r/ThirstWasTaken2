// Spelunkery in a real client: the check of its integration plan
// (docs/dev/integration/world/SPELUNKERY-INTEGRATION.md). What it proves: the ids exist; a bottle drawn from
// Spring Water is Pure even in a plains biome; a fresh water bucket in a furnace is purified, never boiled
// into salt, and a Pure one stays put; and a sea water bucket boils into a salt bucket.
// Runs on both 1.21.1 nodes. Run it unattended:
//     ./gradlew ":1.21.1:runClient" -Pagent=tools/agent/integrations/spelunkery.jsonl -Pquickplay=SpelunkeryAgent
//     ./gradlew ":1.21.1-neoforge:runClient" -Pagent=tools/agent/integrations/spelunkery.jsonl -Pquickplay=SpelunkeryAgent -PwithoutOptional=cold-sweat
// SpelunkeryAgent is a throwaway world, made fresh for each run by
//     python tools/agent/new_world.py <node> SpelunkeryAgent
// Then check what it recorded:
//     python tools/agent/drive.py run/<node>/agent/client tools/agent/integrations/spelunkery.jsonl --verify --max-age 15
//
// Everything happens on a stone floor at y 199, biome plains. The player stands at 0.5 200 0.5.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "alive", "command": "client.state", "expect": {"result.alive": true}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "forceload", "command": "server.command", "args": {"command": "forceload add -8 -8 8 8"}}
{"id": "safe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 3000 4 true"}}
{"id": "tp0", "command": "server.command", "args": {"command": "tp @p 0.5 202 0.5 0 30"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set noon"}}
{"id": "clearWeather", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -8 200 -8 8 210 8 minecraft:air"}}
{"id": "box", "command": "server.command", "args": {"command": "fill -8 194 -8 8 199 8 minecraft:stone"}}
{"id": "plains", "command": "server.command", "args": {"command": "fillbiome -8 190 -8 8 212 8 minecraft:plains"}}

// The ids the script uses: /give refuses an unknown item.
{"id": "id_spring_water_bucket", "command": "server.command", "args": {"command": "give @p spelunkery:spring_water_bucket"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_salt_bucket", "command": "server.command", "args": {"command": "give @p spelunkery:salt_bucket"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "id_salt", "command": "server.command", "args": {"command": "give @p spelunkery:salt"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Gave 1"}]}
{"id": "clearIds", "command": "server.command", "args": {"command": "clear @p"}}

// A Spring Water source sunk into the floor, in plains, where ordinary water would grade by the biome.
// A glass bottle drawn from it is Pure.
{"id": "spring_place", "command": "server.command", "args": {"command": "setblock 0 199 2 spelunkery:spring_water"}}
{"id": "spring_give", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with minecraft:glass_bottle"}}
{"id": "spring_stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 0.5 0 40"}}
{"id": "spring_settle", "command": "wait", "args": {"ticks": 10}}
{"id": "spring_use0", "command": "client.hold", "args": {"keys": ["use"], "ticks": 3}}
{"id": "spring_used0", "command": "wait", "args": {"ticks": 10}}
{"id": "spring_pure", "command": "server.command", "args": {"command": "execute if items entity @p container.* minecraft:potion[thirstwastaken2:water_purity=3]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "spring_remove", "command": "server.command", "args": {"command": "setblock 0 199 2 minecraft:stone"}}
{"id": "spring_clear", "command": "server.command", "args": {"command": "clear @p"}}

// Five furnaces side by side. Spelunkery would boil any of these buckets into salt; only the sea water
// may. Dirty becomes Clean, Murky and Clean become Pure, and a Pure bucket matches nothing and stays.
{"id": "dirty_furnace", "command": "server.command", "args": {"command": "setblock 0 200 4 minecraft:furnace[facing=north,lit=false]"}}
{"id": "dirty_bucket", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.0 with minecraft:water_bucket[thirstwastaken2:water_purity=0,thirstwastaken2:water_salty=false] 1"}}
{"id": "dirty_fuel", "command": "server.command", "args": {"command": "item replace block 0 200 4 container.1 with minecraft:coal 8"}}
{"id": "murky_furnace", "command": "server.command", "args": {"command": "setblock 2 200 4 minecraft:furnace[facing=north,lit=false]"}}
{"id": "murky_bucket", "command": "server.command", "args": {"command": "item replace block 2 200 4 container.0 with minecraft:water_bucket[thirstwastaken2:water_purity=1,thirstwastaken2:water_salty=false] 1"}}
{"id": "murky_fuel", "command": "server.command", "args": {"command": "item replace block 2 200 4 container.1 with minecraft:coal 8"}}
{"id": "clean_furnace", "command": "server.command", "args": {"command": "setblock 4 200 4 minecraft:furnace[facing=north,lit=false]"}}
{"id": "clean_bucket", "command": "server.command", "args": {"command": "item replace block 4 200 4 container.0 with minecraft:water_bucket[thirstwastaken2:water_purity=2,thirstwastaken2:water_salty=false] 1"}}
{"id": "clean_fuel", "command": "server.command", "args": {"command": "item replace block 4 200 4 container.1 with minecraft:coal 8"}}
{"id": "pure_furnace", "command": "server.command", "args": {"command": "setblock 6 200 4 minecraft:furnace[facing=north,lit=false]"}}
{"id": "pure_bucket", "command": "server.command", "args": {"command": "item replace block 6 200 4 container.0 with minecraft:water_bucket[thirstwastaken2:water_purity=3,thirstwastaken2:water_salty=false] 1"}}
{"id": "pure_fuel", "command": "server.command", "args": {"command": "item replace block 6 200 4 container.1 with minecraft:coal 8"}}
{"id": "sea_furnace", "command": "server.command", "args": {"command": "setblock -2 200 4 minecraft:furnace[facing=north,lit=false]"}}
{"id": "sea_bucket", "command": "server.command", "args": {"command": "item replace block -2 200 4 container.0 with minecraft:water_bucket[thirstwastaken2:water_salty=true] 1"}}
{"id": "sea_fuel", "command": "server.command", "args": {"command": "item replace block -2 200 4 container.1 with minecraft:coal 8"}}
{"id": "smelting", "command": "wait", "args": {"ticks": 280}}
{"id": "dirty_purified", "command": "server.command", "args": {"command": "execute if data block 0 200 4 Items[{Slot:2b,id:\"minecraft:water_bucket\",components:{\"thirstwastaken2:water_purity\":2}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "murky_purified", "command": "server.command", "args": {"command": "execute if data block 2 200 4 Items[{Slot:2b,id:\"minecraft:water_bucket\",components:{\"thirstwastaken2:water_purity\":3}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "clean_purified", "command": "server.command", "args": {"command": "execute if data block 4 200 4 Items[{Slot:2b,id:\"minecraft:water_bucket\",components:{\"thirstwastaken2:water_purity\":3}}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pure_left", "command": "server.command", "args": {"command": "execute if data block 6 200 4 Items[{Slot:0b,id:\"minecraft:water_bucket\"}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "pure_no_output", "command": "server.command", "args": {"command": "execute unless data block 6 200 4 Items[{Slot:2b}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}
{"id": "sea_salt", "command": "server.command", "args": {"command": "execute if data block -2 200 4 Items[{Slot:2b,id:\"spelunkery:salt_bucket\"}]"}, "checks": [{"left": "result.messages.0", "op": "contains", "value": "Test passed"}]}

{"id": "done", "command": "wait", "args": {"ticks": 20}}
