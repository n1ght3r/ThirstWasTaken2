// ---- Regeneration --------------------------------------------------------------------------------
// Both mods hook FoodData.tick, on different calls. Low thirst stops healing (this mod); full thirst
// heals. The last case freezes the player through Cold Sweat and is read by hand: Cold Sweat freezes
// part of the hearts, so health should stop short of full while thirst is full.
{"id": "regenClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "regenNoResistance", "command": "server.command", "args": {"command": "effect clear @p minecraft:resistance"}}
{"id": "regenFed", "command": "server.command", "args": {"command": "effect give @p minecraft:saturation 1 20 true"}}
{"id": "regenAt", "command": "server.command", "args": {"command": "tp @p 0.5 200 -3.5 0 0"}}
{"id": "regenThirsty", "command": "server.command", "args": {"command": "thirst set @p 10 0"}}
{"id": "regenHurt", "command": "server.command", "args": {"command": "damage @p 8 minecraft:generic"}}
{"id": "regenHurtState", "command": "client.state"}
{"id": "regenWaitThirsty", "command": "wait", "args": {"ticks": 200}}
{"id": "regenThirstyState", "command": "client.state", "checks": [{"left": "result.health", "op": "le", "value": 12}]}
{"id": "regenQuenched", "command": "server.command", "args": {"command": "thirst set @p 20 20"}}
{"id": "regenWaitQuenched", "command": "wait", "args": {"ticks": 200}}
{"id": "regenQuenchedState", "command": "client.state", "checks": [{"left": "result.health", "op": "gt", "value": 12}]}
{"id": "regenFreeze", "command": "server.command", "args": {"command": "temp set @p -90"}}
{"id": "regenHurtCold", "command": "server.command", "args": {"command": "damage @p 8 minecraft:generic"}}
{"id": "regenWaitCold", "command": "wait", "args": {"ticks": 300}}
{"id": "regenColdState", "command": "client.state"}
{"id": "regenColdBody", "command": "server.command", "args": {"command": "temp get @p body"}}
{"id": "regenWarm", "command": "server.command", "args": {"command": "temp set @p 0"}}
{"id": "regenSafe", "command": "server.command", "args": {"command": "effect give @p minecraft:resistance 600 4 true"}}

// ---- Hot drinks warm (step 7) --------------------------------------------------------------------
// Farmer's Delight's hot cocoa, which Cold Sweat lists nothing for, raises the base temperature by 10
// for a minute through this integration's food data. Read by hand: base after is 10 above before.
{"id": "cocoaThirsty", "command": "server.command", "args": {"command": "thirst set @p 4 0"}}
{"id": "cocoa", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with farmersdelight:hot_cocoa"}}
{"id": "baseBefore", "command": "server.command", "args": {"command": "temp get @p base"}}
{"id": "settleCocoa", "command": "wait", "args": {"ticks": 20}}
{"id": "drinkCocoa", "command": "client.hold", "args": {"keys": ["use"], "ticks": 50}}
{"id": "drankCocoa", "command": "wait", "args": {"ticks": 10}}
{"id": "baseAfter", "command": "server.command", "args": {"command": "temp get @p base"}}
{"id": "cocoaQuenched", "command": "client.state", "checks": [{"left": "result.thirst", "op": "gt", "value": 4}]}

// The HUD beside Cold Sweat's body temperature gauge, at the configured hudPosition, to look at.
{"id": "hudSkin", "command": "server.command", "args": {"command": "item replace entity @p weapon.mainhand with cold_sweat:filled_waterskin[thirstwastaken2:water_purity=2,thirstwastaken2:water_salty=false]"}}
{"id": "settleHud", "command": "wait", "args": {"ticks": 20}}
{"id": "hud", "command": "client.capture", "args": {"name": "cold-sweat-hud"}}

// The skin holds one serving, at Cold Sweat's default of one use, and is emptied or filled whole. A Dirty
// skin pours one serving into an empty copper hanging pot and comes back empty; the empty skin draws it
// back out as a Dirty skin. Then the distiller: a Dirty skin pours one serving into the boiler, and an
// empty skin draws one from the basin as a Pure skin.
{"id": "potPlace", "command": "server.command", "args": {"command": "setblock 12 200 2 thirstwastaken2:copper_hanging_pot"}}
{"id": "potPourClear", "command": "server.command", "args": {"command": "clear @p"}}
