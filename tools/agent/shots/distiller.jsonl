{"id": "run", "command": "wait", "args": {"ticks": 400}}
{"id": "aimScene", "command": "server.command", "args": {"command": "tp @p -256.0 72.0 189.0 -9.5 19"}}
{"id": "settleScene", "command": "wait", "args": {"ticks": 40}}
{"id": "scene1", "command": "client.capture", "args": {"name": "copper-distiller-1"}}
