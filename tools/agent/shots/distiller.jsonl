{"id": "pressGui", "command": "client.key", "args": {"key": "use", "down": true}}
{"id": "pressedGui", "command": "wait", "args": {"ticks": 3}}
{"id": "releaseGui", "command": "client.key", "args": {"key": "use", "down": false}}
