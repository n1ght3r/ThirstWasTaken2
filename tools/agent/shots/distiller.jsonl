// The Copper Distiller docs images: docs/public/screenshots/water/copper-distiller.png, the machine at
// work on the plains with Jade reading its tanks; copper-distiller-front.png, the same from the front with
// the HUD hidden while the fire burns, close up like the hanging pot's; copper-distiller-gui.png, its screen distilling sea
// water; and the five crafting grids in docs/public/screenshots/recipes/ (copper-pipe, distiller-boiler,
// cooling-tub, brick-firebox, copper-distiller), each with the result's name drawn beside it by
// tools/generate_docs_images.py's tooltip() from the "*Tooltip" answers. Shot on 26.2 on the plains at
// -256 72 192, the hanging pot's spot, in a copy of the dev world's seed:
//     python tools/agent/new_world.py 26.2.x DistillerShots --from "New World"
//     ./gradlew ":26.2.x:runClient" -Pdriven -Pagent=tools/agent/shots/distiller.jsonl -Pquickplay=DistillerShots
// The machine faces north, the boiler at -256 and the tub to its west; the camera stands north of it.
// tp sets the feet; the eye is 1.62 above, so the scene's camera stands on the ground for Jade to read the
// boiler. Keep the capture with the most of the machine in frame. The "*Placed" checks have to say "Test passed".

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "joined", "command": "client.state"}
{"id": "quiet", "command": "server.command", "args": {"command": "gamerule sendCommandFeedback false"}}
{"id": "spectator", "command": "server.command", "args": {"command": "gamemode spectator @p"}}
{"id": "scene", "command": "server.command", "args": {"command": "tp @p -256.0 73.6 188.6 0 18"}}
{"id": "chunks", "command": "wait", "args": {"ticks": 100}}
{"id": "day", "command": "server.command", "args": {"command": "time set day"}}
{"id": "hold", "command": "server.command", "args": {"command": "gamerule advance_time false"}}
{"id": "clear", "command": "server.command", "args": {"command": "weather clear 100000"}}
{"id": "peaceful", "command": "server.command", "args": {"command": "difficulty peaceful"}}

// Grass and flowers round the machine would hide its base; the ground itself stays.
{"id": "space", "command": "server.command", "args": {"command": "fill -259 72 188 -253 75 194 minecraft:air replace #minecraft:replaceable"}}
{"id": "boiler", "command": "server.command", "args": {"command": "setblock -256 72 192 thirstwastaken2:copper_distiller[facing=north,part=boiler,piped=true,cooled=true]"}}
{"id": "tub", "command": "server.command", "args": {"command": "setblock -257 72 192 thirstwastaken2:copper_distiller[facing=north,part=tub,piped=true,cooled=true]"}}
{"id": "boilerPlaced", "command": "server.command", "args": {"command": "execute if block -256 72 192 thirstwastaken2:copper_distiller[part=boiler]"}}
{"id": "tubPlaced", "command": "server.command", "args": {"command": "execute if block -257 72 192 thirstwastaken2:copper_distiller[part=tub]"}}

// Sea water and coal in: a few servings on, both tanks hold water and the fire burns.
{"id": "coal", "command": "server.command", "args": {"command": "item replace block -256 72 192 container.1 with minecraft:coal 8"}}
{"id": "sea1", "command": "server.command", "args": {"command": "item replace block -256 72 192 container.0 with minecraft:water_bucket[thirstwastaken2:water_salty=true]"}}
{"id": "pour1", "command": "wait", "args": {"ticks": 40}}
{"id": "sea2", "command": "server.command", "args": {"command": "item replace block -256 72 192 container.0 with minecraft:water_bucket[thirstwastaken2:water_salty=true]"}}

// The clean front shot: HUD hidden, so no Jade and no crosshair, while the fire still burns.
{"id": "boiling", "command": "wait", "args": {"ticks": 120}}
{"id": "aimFront", "command": "server.command", "args": {"command": "tp @p -256.0 72.28 190.4 0 24"}}
{"id": "settleFront", "command": "wait", "args": {"ticks": 40}}
{"id": "hideHud", "command": "client.hud.toggle"}
{"id": "front1", "command": "client.capture", "args": {"name": "copper-distiller-front-1"}}
{"id": "gapFront", "command": "wait", "args": {"ticks": 30}}
{"id": "front2", "command": "client.capture", "args": {"name": "copper-distiller-front-2"}}
{"id": "gapFront2", "command": "wait", "args": {"ticks": 30}}
{"id": "front3", "command": "client.capture", "args": {"name": "copper-distiller-front-3"}}
