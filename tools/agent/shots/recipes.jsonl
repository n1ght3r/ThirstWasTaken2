// The container recipe images in docs/public/screenshots/recipes/ that changed with the purification
// rework: clay-bowl (three clay balls, three bowls), waterskin (four leather in a ring), copper-canteen
// (string over three copper), iron-flask
// (an iron nugget over three iron) and distiller-boiler (copper round an iron ingot). Each grid is filled
// through client.slot and captured unhovered; tools/agent/shots/recipe_images.py crops the panel and
// draws the result's tooltip beside it from the "*Tooltip" answers. Shot on 26.2, in any world:
//     python tools/agent/new_world.py 26.2.x RecipeShots --from "New World"
//     ./gradlew ":26.2.x:runClient" -Pdriven -Pagent=tools/agent/shots/recipes.jsonl -Pquickplay=RecipeShots
// Turn Jade's itemModNameTooltip off first (run/26.2.x/config/jade/jade.json), or the tooltip answers
// gain a mod name line. Grid slots are 1 to 9, row by row.

{"id": "load", "command": "wait", "args": {"ticks": 400}}
{"id": "joined", "command": "client.state"}
{"id": "quiet", "command": "server.command", "args": {"command": "gamerule sendCommandFeedback false"}}
{"id": "peaceful", "command": "server.command", "args": {"command": "difficulty peaceful"}}
{"id": "float", "command": "server.command", "args": {"command": "effect give @p minecraft:slow_falling 600 0 true"}}
{"id": "air", "command": "server.command", "args": {"command": "fill -2 200 -2 2 203 2 minecraft:air"}}
{"id": "floor", "command": "server.command", "args": {"command": "fill -2 199 -2 2 199 2 minecraft:stone"}}
{"id": "table", "command": "server.command", "args": {"command": "setblock 0 200 1 minecraft:crafting_table"}}
{"id": "stand", "command": "server.command", "args": {"command": "tp @p 0.5 200 -0.5 0 35"}}
{"id": "survival", "command": "server.command", "args": {"command": "gamemode survival @p"}}
{"id": "settle", "command": "wait", "args": {"ticks": 60}}

{"id": "bowlClear", "command": "server.command", "args": {"command": "clear @p"}}
{"id": "bowlGive", "command": "server.command", "args": {"command": "item replace entity @p container.9 with minecraft:clay_ball 3"}}
{"id": "bowlSettle", "command": "wait", "args": {"ticks": 10}}
{"id": "bowlOpen", "command": "client.hold", "args": {"keys": ["use"], "ticks": 5}}
{"id": "bowlOpened", "command": "wait", "args": {"ticks": 10}}
{"id": "bowlTake", "command": "client.slot", "args": {"inventory": 9}}
{"id": "bowlPut1", "command": "client.slot", "args": {"slot": 1, "button": 1}}
{"id": "bowlPut3", "command": "client.slot", "args": {"slot": 3, "button": 1}}
{"id": "bowlPut5", "command": "client.slot", "args": {"slot": 5, "button": 1}}
{"id": "bowlGrid", "command": "client.slots", "expect": {"result.slots.0.item": "thirstwastaken2:clay_bowl", "result.slots.0.count": 3}}
{"id": "bowlRecipe", "command": "client.capture", "args": {"name": "clay-bowl-recipe"}}
{"id": "bowlTooltip", "command": "client.tooltip", "args": {"item": "thirstwastaken2:clay_bowl"}}
{"id": "bowlClose", "command": "client.screen", "args": {"open": "none"}}

{"id": "skinClear", "command": "server.command", "args": {"command": "clear @p"}}
