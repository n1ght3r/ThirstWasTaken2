{"id": "skinTake", "command": "client.slot", "args": {"inventory": 9}}
{"id": "skinPut2", "command": "client.slot", "args": {"slot": 2, "button": 1}}
{"id": "skinPut4", "command": "client.slot", "args": {"slot": 4, "button": 1}}
{"id": "skinPut6", "command": "client.slot", "args": {"slot": 6, "button": 1}}
