.gradle/
build/
# Kotlin's per-project data, which build-logic's `kotlin-dsl` writes: compiler daemon error reports and
# incremental caches.
.kotlin/
versions/
run/
out/

# Datagen writes a hash cache next to its output; the output itself is committed.
src/main/generated/*/.cache/
*.iml
.idea/
.vscode/
# The sprite and logo workbench: generated images and the scripts that draw them, kept locally.
# `tools/*` rather than `tools/`, because git cannot re-include anything under an excluded directory,
# and tools/agent below has to be re-included.
tools/*
# What an agent sends to a running game, and what runs the benchmark over every node and reduces the
# reports. src/dev/java/AGENTS.md documents both as part of the workflow, so they belong in the
# repository rather than on one machine.
!tools/agent/
!tools/benchmark/
# What publishes a release to Modrinth and CurseForge. It reads the properties file every node is
# described in, so it belongs beside them rather than on one machine; its tokens stay in .env.
!tools/release/
# What a node's name says, which CI, the release, benchmark and dependency scripts all ask.
!tools/node_names.py

# Bytecode from running .github/scripts by hand.
__pycache__/

# Local agent workspace
.claude/

# Local documentation workspace
local-docs

# Local environment variables
.env